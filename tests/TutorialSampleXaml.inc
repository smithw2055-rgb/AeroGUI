                                <ProgressBar Value="40" Minimum="0" Maximum="100" Margin="10,0" Orientation="Vertical" />
                                <ProgressBar Value="40" Minimum="0" Maximum="100" IsIndeterminate="True" Orientation="Vertical" />
                            </StackPanel>
                            <Slider x:Name="slider1" Value="20" Minimum="0" Maximum="100" />
                            <Slider Value="4" TickPlacement="TopLeft" Margin="0,10" />
                            <Slider Value="6" TickPlacement="BottomRight" />
                            <Slider Value="8" TickPlacement="Both" Margin="0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="50">
                                <Slider Value="2" TickFrequency="2" TickPlacement="TopLeft" Orientation="Vertical" />
                                <Slider Value="4" TickFrequency="2" TickPlacement="BottomRight" Orientation="Vertical" Margin="10,0" />
                                <Slider Value="6" TickFrequency="2" TickPlacement="Both" Orientation="Vertical" IsDirectionReversed="True" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Scroll">
