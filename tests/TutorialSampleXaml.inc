    {"Menu3D", "MainMenu.xaml", R"AEROXAML(<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:local="clr-namespace:Menu3D"
    x:Class="Menu3D.MainMenu"
    x:Name="MainMenuControl"
    d:DesignWidth="1300" d:DesignHeight="900"
    FontFamily="Fonts/#WeblySleek UI Semilight">
    <UserControl.Resources>
        <ResourceDictionary>
            <Storyboard x:Key="FadeIn">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ToolTips">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="MainMenuControl">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
                <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsEnabled)" Storyboard.TargetName="MainMenuControl">
                    <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                    <DiscreteBooleanKeyFrame KeyTime="0:0:0.2" Value="True"/>
                </BooleanAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.65"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0.65"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0" Value="-550"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0" Value="50"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="MenuOptions">
                    <EasingDoubleKeyFrame KeyTime="0" Value="-100"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="MenuDesc">
                    <EasingDoubleKeyFrame KeyTime="0" Value="-400"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="FadeOut">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ToolTips">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="MainMenuControl">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>
                <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsEnabled)" Storyboard.TargetName="MainMenuControl">
                    <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                </BooleanAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseIn"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.65">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseIn" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.65">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseIn" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-550">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseIn" Amplitude="0.15"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-800">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="ContentRoot">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="50">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseIn"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="MenuOptions">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-100"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="MenuDesc">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-400"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <noesis:SetFocusAction TargetName="Start"/>
        </b:EventTrigger>
        <b:DataTrigger Binding="{Binding State}" Value="{x:Static local:State.Main}">
            <b:ChangePropertyAction TargetName="Start" PropertyName="MinHeight" Value="1"/>
            <b:ControlStoryboardAction Storyboard="{StaticResource FadeIn}"/>
        </b:DataTrigger>
        <b:StoryboardCompletedTrigger Storyboard="{StaticResource FadeIn}">
            <noesis:SetFocusAction TargetName="LayoutRoot"/>
            <b:ChangePropertyAction TargetName="Start" PropertyName="MinHeight" Value="0"/>
        </b:StoryboardCompletedTrigger>
        <b:DataTrigger Binding="{Binding State}" Comparison="NotEqual" Value="{x:Static local:State.Main}">
            <b:ControlStoryboardAction Storyboard="{StaticResource FadeOut}"/>
        </b:DataTrigger>
        <b:KeyTrigger Key="Esc" ActiveOnFocus="True">
            <b:PlaySoundAction Source="Sounds/WaterDropBig.mp3" Volume="0.5"/>
            <b:InvokeCommandAction Command="{Binding Exit}"/>
        </b:KeyTrigger>
    </b:Interaction.Triggers>

    <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5" FocusManager.IsFocusScope="True">
        <Viewbox>
            <Grid Width="1300" Height="900">
                <noesis:Element.Transform3D>
                    <noesis:CompositeTransform3D RotationY="-8"/>
                </noesis:Element.Transform3D>
              <Grid x:Name="ContentRoot">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="MenuTitle" Orientation="Vertical" HorizontalAlignment="Left">
                    <Viewbox x:Name="Logo" Stretch="Uniform" Height="100" Margin="0,-9,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource NoesisLogoGeometry}" Fill="{StaticResource NoesisLogoBlue}" Stretch="Uniform"/>
                            <Path Data="{StaticResource NoesisTextGeometry}" Fill="White" Stretch="Uniform" Margin="40,0,0,0" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource NoesisGuiTextGeometry}" Fill="{StaticResource NoesisLogoBlue}" Stretch="Uniform" Margin="40,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Text="MENU DEMO" FontSize="50" HorizontalAlignment="Right" Margin="0,-19,-2,0" Foreground="{StaticResource TransparentWhiteBrush95}"/>
                </StackPanel>
                <Grid x:Name="MenuOptions" Grid.Row="1" Width="640" HorizontalAlignment="Left" Margin="0,30,0,0" RenderTransformOrigin="0.5,0.5"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Cycle" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Margin="-20,0,0,50">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00083A5E"/>
                                <GradientStop Color="#66083A5E" Offset="0.12"/>
                                <GradientStop Color="#4C083A5E" Offset="0.5"/>
                                <GradientStop Color="#00083A5E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <Rectangle Height="2" Margin="0,0,0,2" Fill="{StaticResource HorizontalLineBg}"/>
                        <ToggleButton x:Name="Start" Style="{StaticResource MenuButtonStyle}" MinWidth="624" Content="START GAME" Command="{Binding Start}"/>
                        <ToggleButton x:Name="Settings" Style="{StaticResource MenuButtonStyle}" MinWidth="624" Content="SETTINGS" Command="{Binding Settings}"/>
                        <ToggleButton x:Name="Exit" Style="{StaticResource MenuButtonStyle}" MinWidth="624" Content="EXIT" Command="{Binding Exit}"/>
                        <Rectangle Height="2" Margin="0,100,0,2" Fill="{StaticResource HorizontalLineBg}"/>
                        <Grid x:Name="ToolTips" Margin="18,4,0,0">
                            <ContentControl Style="{StaticResource MenuToolTipStyle}" Content="Dive straight into the adventure." IsEnabled="{Binding IsKeyboardFocused, ElementName=Start}"/>
                            <ContentControl Style="{StaticResource MenuToolTipStyle}" Content="Configure the settings for the demo." IsEnabled="{Binding IsKeyboardFocused, ElementName=Settings}"/>
                            <ContentControl Style="{StaticResource MenuToolTipStyle}" Content="Exit the demo." IsEnabled="{Binding IsKeyboardFocused, ElementName=Exit}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <local:MenuDescription x:Name="MenuDesc" Description="MAIN MENU" AcceptText="ACCEPT" CancelText="EXIT" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
                    <local:MenuDescription.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </local:MenuDescription.RenderTransform>
                </local:MenuDescription>
            </Grid>
          </Grid>
        </Viewbox>
    </Grid>
</UserControl>)AEROXAML"},
    {"Menu3D", "MainWindow.xaml", R"AEROXAML(<Window x:Class="Menu3D.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Menu3D"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    Title="NoesisGUI - Menu3D"
    FontFamily="Fonts/#WeblySleek UI Semilight">
    <Window.Resources>
        <local:MultiplierConverter x:Key="MultiplierConverter"/>
        <Storyboard x:Key="BackgroundAnim">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="SkyAndSun" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:5:00" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="BackClouds" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:3:20" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="Mountains" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:2:30" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="FrontClouds" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:1:40" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Storyboard.TargetName="FrontTrees" RepeatBehavior="Forever">
                <EasingDoubleKeyFrame KeyTime="0:1:12" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:ControlStoryboardAction Storyboard="{StaticResource BackgroundAnim}"/>
            <b:PlaySoundAction Source="Sounds/SoundTrack.mp3" Volume="1"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid Margin="0,0,0,-1" d:IsLocked="True">
            <Grid.Resources>
                <ImageSource x:Key="Image.SkyAndSun">Images/SkyAndSun.jpg</ImageSource>
                <ImageSource x:Key="Image.Mountains">Images/LakeAndMountains.png</ImageSource>
                <ImageSource x:Key="Image.FrontTrees">Images/FrontTrees.png</ImageSource>
                <ImageSource x:Key="Image.BackClouds">Images/BackClouds.png</ImageSource>
                <ImageSource x:Key="Image.FrontClouds">Images/FrontClouds.png</ImageSource>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="135*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="24*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="80*"/>
                <RowDefinition Height="190*"/>
                <RowDefinition Height="221*"/>
            </Grid.RowDefinitions>
            <Decorator x:Name="SkyAndSunRef" Grid.Row="0" Grid.RowSpan="6"/>
            <Canvas Grid.Row="0" Grid.RowSpan="6">
                <StackPanel x:Name="SkyAndSun" Orientation="Horizontal" Height="{Binding ActualHeight, ElementName=SkyAndSunRef}"
                            Canvas.Left="{Binding ActualWidth, ElementName=SkyAndSunWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="{Binding ActualWidth, ElementName=SkyAndSunWidth}"/>
                    </StackPanel.RenderTransform>
                    <Image x:Name="SkyAndSunWidth" Source="{StaticResource Image.SkyAndSun}" />
                    <Image Source="{StaticResource Image.SkyAndSun}" Margin="0,0,0,0"/>
                    <Image Source="{StaticResource Image.SkyAndSun}" Margin="0,0,0,0"/>
                </StackPanel>
            </Canvas>
            <Decorator x:Name="BackCloudsRef" Grid.Row="1" Grid.RowSpan="3"/>
            <Canvas Grid.Row="1" Grid.RowSpan="4">
                <StackPanel x:Name="BackClouds" Orientation="Horizontal" Height="{Binding ActualHeight, ElementName=BackCloudsRef}"
                            Canvas.Right="{Binding ActualWidth, ElementName=BackCloudsWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="{Binding ActualWidth, ElementName=BackCloudsWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}"/>
                    </StackPanel.RenderTransform>
                    <Image x:Name="BackCloudsWidth" Source="{StaticResource Image.BackClouds}"/>
                    <Image Source="{StaticResource Image.BackClouds}"/>
                    <Image Source="{StaticResource Image.BackClouds}"/>
                </StackPanel>
            </Canvas>
            <Decorator x:Name="MountainsRef" Grid.Row="3" Grid.RowSpan="5"/>
            <Canvas Grid.Row="3" Grid.RowSpan="5">
                <StackPanel x:Name="Mountains" Orientation="Horizontal" Height="{Binding ActualHeight, ElementName=MountainsRef}"
                            Canvas.Left="{Binding ActualWidth, ElementName=MountainsWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="{Binding ActualWidth, ElementName=MountainsWidth}"/>
                    </StackPanel.RenderTransform>
                    <Image x:Name="MountainsWidth" Source="{StaticResource Image.Mountains}"/>
                    <Image Source="{StaticResource Image.Mountains}" Margin="0,0,0,0"/>
                    <Image Source="{StaticResource Image.Mountains}" Margin="0,0,0,0"/>
                </StackPanel>
            </Canvas>
            <Decorator x:Name="FrontCloudsRef" Grid.Row="2" Grid.RowSpan="3"/>
            <Canvas Grid.Row="2" Grid.RowSpan="3">
                <StackPanel x:Name="FrontClouds" Orientation="Horizontal" Height="{Binding ActualHeight, ElementName=FrontCloudsRef}"
                            Canvas.Right="{Binding ActualWidth, ElementName=FrontCloudsWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="{Binding ActualWidth, ElementName=FrontCloudsWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}"/>
                    </StackPanel.RenderTransform>
                    <Image x:Name="FrontCloudsWidth" Source="{StaticResource Image.FrontClouds}"/>
                    <Image Source="{StaticResource Image.FrontClouds}"/>
                    <Image Source="{StaticResource Image.FrontClouds}"/>
                </StackPanel>
            </Canvas>
            <Decorator x:Name="FrontTreesRef" Grid.Row="7"/>
            <Canvas Grid.Row="7">
                <StackPanel x:Name="FrontTrees" Orientation="Horizontal" Height="{Binding ActualHeight, ElementName=FrontTreesRef}"
                            Canvas.Left="{Binding ActualWidth, ElementName=FrontTreesWidth, Converter={StaticResource MultiplierConverter}, ConverterParameter=-1}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="{Binding ActualWidth, ElementName=FrontTreesWidth}"/>
                    </StackPanel.RenderTransform>
                    <Image x:Name="FrontTreesWidth" Source="{StaticResource Image.FrontTrees}"/>
                    <Image Source="{StaticResource Image.FrontTrees}" Margin="0,0,0,0"/>
                    <Image Source="{StaticResource Image.FrontTrees}" Margin="0,0,0,0"/>
                </StackPanel>
            </Canvas>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <local:MainMenu x:Name="Main" Grid.Row="1" Grid.Column="1"/>
            <local:StartMenu x:Name="Start" Grid.Row="1" Grid.Column="1" Visibility="Hidden"/>
            <local:SettingsMenu x:Name="Settings" Grid.Row="1" Grid.Column="1" Visibility="Hidden"/>
        </Grid>
    </Grid>
</Window>)AEROXAML"},
    {"Menu3D", "MenuDescription.xaml", R"AEROXAML(<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Menu3D"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors" x:Class="Menu3D.MenuDescription"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="800" d:DesignHeight="240">
    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Binding Description, ElementName=Root, FallbackValue=DESCRIPTION}" FontSize="64" Foreground="{StaticResource TransparentWhiteBrush50}" FontFamily="Fonts/#WeblySleek UI Semibold"/>
        <TextBlock Text="/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////" FontWeight="Bold" FontFamily="Fonts/#WeblySleek UI Semibold" Foreground="#7FFFFFFF" Margin="0,-4,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
            <b:Interaction.Triggers>
                <b:DataTrigger Binding="{Binding Platform}" Value="PC">
                    <b:ChangePropertyAction TargetName="XBOXAccept" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="XBOXCancel" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="PS4Accept" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="PS4Cancel" PropertyName="Visibility" Value="Collapsed"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding Platform}" Value="XBOX">
                    <b:ChangePropertyAction TargetName="PCAccept" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="PCCancel" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="PS4Accept" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="PS4Cancel" PropertyName="Visibility" Value="Collapsed"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding Platform}" Value="PS4">
                    <b:ChangePropertyAction TargetName="PCAccept" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="PCCancel" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="XBOXAccept" PropertyName="Visibility" Value="Collapsed"/>
                    <b:ChangePropertyAction TargetName="XBOXCancel" PropertyName="Visibility" Value="Collapsed"/>
                </b:DataTrigger>
            </b:Interaction.Triggers>
            <Border x:Name="PCAccept" CornerRadius="4" BorderThickness="2" BorderBrush="{StaticResource TransparentWhiteBrush75}" Padding="8,2" VerticalAlignment="Center">
                <TextBlock Text="ENTER" Foreground="{StaticResource TransparentWhiteBrush75}" FontSize="20" FontFamily="Fonts/#WeblySleek UI Semibold"/>
            </Border>
            <Grid x:Name="XBOXAccept">
                <Ellipse Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" StrokeThickness="1.7" Stroke="{StaticResource TransparentWhiteBrush75}" Margin="0,-2"/>
                <TextBlock Text="A" FontSize="20" FontFamily="Fonts/#WeblySleek UI Semibold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Foreground="#FFAEFF80"/>
            </Grid>
            <Grid x:Name="PS4Accept">
                <Ellipse Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" StrokeThickness="1.7" Stroke="{StaticResource TransparentWhiteBrush75}" Margin="0,-2"/>
                <TextBlock Text="X" FontSize="20" FontFamily="Fonts/#WeblySleek UI Semibold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Foreground="#BF9ABAFF"/>
            </Grid>
            <TextBlock Text="{Binding AcceptText, ElementName=Root, FallbackValue=ACCEPT}" Foreground="{StaticResource TransparentWhiteBrush75}" VerticalAlignment="Center" Margin="10,-10,50,-7" FontSize="30"/>
            <Border x:Name="PCCancel" CornerRadius="4" BorderThickness="2" BorderBrush="{StaticResource TransparentWhiteBrush75}" Padding="8,2" VerticalAlignment="Center">
                <TextBlock Text="ESC" Foreground="{StaticResource TransparentWhiteBrush75}" FontSize="20" FontFamily="Fonts/#WeblySleek UI Semibold"/>
            </Border>
            <Grid x:Name="XBOXCancel" Margin="0,-2">
                <Ellipse Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" StrokeThickness="1.7" Stroke="{StaticResource TransparentWhiteBrush75}"/>
                <TextBlock Text="B" FontSize="20" FontFamily="Fonts/#WeblySleek UI Semibold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Foreground="#FFF37572"/>
            </Grid>
            <Grid x:Name="PS4Cancel">
                <Ellipse Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" StrokeThickness="1.7" Stroke="{StaticResource TransparentWhiteBrush75}" Margin="0,-2"/>
                <TextBlock Text="O" FontSize="20" FontFamily="Fonts/#WeblySleek UI Semibold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Foreground="#BFFFA0CB"/>
            </Grid>
            <TextBlock Text="{Binding CancelText, ElementName=Root, FallbackValue=CANCEL}" Foreground="{StaticResource TransparentWhiteBrush75}" VerticalAlignment="Center" Margin="10,-10,0,-7" FontSize="30"/>
        </StackPanel>
    </StackPanel>
</UserControl>
)AEROXAML"},
