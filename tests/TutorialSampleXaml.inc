            <Run Text="a user can write their own effects using a pixel shader. In this example we created a"/>
            <Run FontWeight="Bold">PixelateEffect</Run>
            <Run Text="which provides a"/>
            <Run FontWeight="Bold">Size</Run>
            <Run Text="property to define the size of the pixelation."/>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="#01000000" Margin="0,10,0,0">
          <Border.Effect>
            <noesis:PixelateEffect Size="{Binding Value, ElementName=size}"/>
          </Border.Effect>
          <Image Width="360" Height="180" Stretch="UniformToFill" Source="Images/Nature.png" Margin="50,0"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
          <TextBlock Text="Size:" Margin="0,0,20,0"/>
          <Slider x:Name="size" Minimum="0.0001" Maximum="45" Value="5" Width="180"/>
          <TextBlock Text="{Binding Value, ElementName=size, StringFormat=F1}" Width="50" TextAlignment="Right"/>
        </StackPanel>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/Expander.xaml", R"AEROXAML(<HeaderedContentControl
