      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Touch Scrolling"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>To enable touch scrolling the ScrollViewer should set the</Run>
            <Run FontWeight="Bold">PanningMode</Run>
            <Run>property to the appropriate value:</Run>
            <Run FontWeight="Bold">Both</Run><Run>,</Run>
            <Run FontWeight="Bold">HorizontalFirst</Run><Run>,</Run>
            <Run FontWeight="Bold">HorizontalOnly</Run><Run>,</Run>
            <Run FontWeight="Bold">VerticalFirst</Run><Run>,</Run>
            <Run FontWeight="Bold">VerticalOnly</Run>
            <Run>or</Run>
            <Run FontWeight="Bold">None</Run><Run>.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
          <TextBlock Text="PanningMode:  " VerticalAlignment="Center"/>
          <ComboBox x:Name="Panning" SelectedIndex="0" Width="270">
            <ComboBoxItem Content="Both"/>
            <ComboBoxItem Content="HorizontalFirst"/>
            <ComboBoxItem Content="HorizontalOnly"/>
            <ComboBoxItem Content="VerticalFirst"/>
            <ComboBoxItem Content="VerticalOnly"/>
            <ComboBoxItem Content="None"/>
          </ComboBox>
        </StackPanel>
        <ScrollViewer Width="380" Height="200" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PanningMode="{Binding SelectedItem.Content, ElementName=Panning}">
          <Grid>
            <Image Source="Images/Nature.png" Width="750" Height="500"/>
            <TextBlock Text="Photo by Frank McKenna" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="10" Foreground="#80000000" Margin="20"/>
          </Grid>
        </ScrollViewer>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/Slider.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:local="clr-namespace:Gallery"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="Slider"
    Tag="https://www.noesisengine.com/docs/Gui.Core._Slider.html">

    <StackPanel>
        <TextBlock Style="{StaticResource SampleSectionDesc}" Text="Use a Slider when you want your users to be able to select from a range of values by moving a thumb control along a track." />
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/24a4c593cd8feabea3d7bba35b07d158" TabIndex="100">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Orientation and Ticks"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold">TickPlacement</Run>
                        <Run>property defines how to position the tick marks in a Slider with respect to the slider bar.</Run>
                        <Run FontWeight="Bold">TickFrequency</Run>
                        <Run>property determines the distance between tick marks.</Run>
                        <Run>User can also specify custom ticks by setting the</Run>
                        <Run FontWeight="Bold">Ticks</Run>
                        <Run>property. To revert the direction of the slider set the property</Run>
                        <Run FontWeight="Bold">IsDirectionReversed</Run><Run>.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="4" Text="Horizontal Sliders" TextAlignment="Right" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Column="0" Grid.Row="1" Text="No ticks" TextAlignment="Right" Margin="2" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Grid.Row="1" x:Name="Slider1" Margin="8,4,6,2"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Margin="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider1, StringFormat=F2}"/>

                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Top ticks" TextAlignment="Right" Margin="2" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Grid.Row="2" x:Name="Slider2" Margin="8,4,6,2" TickPlacement="TopLeft"/>
                    <TextBlock Grid.Column="2" Grid.Row="2" Margin="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider2, StringFormat=F2}"/>

                    <TextBlock Grid.Column="0" Grid.Row="3" Text="Ticks on both" TextAlignment="Right" Margin="2" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Grid.Row="3" x:Name="Slider3" Margin="8,4,6,2" TickPlacement="Both" IsDirectionReversed="True"/>
                    <TextBlock Grid.Column="2" Grid.Row="3" Margin="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider3, StringFormat=F2}"/>

                    <TextBlock Grid.Column="0" Grid.Row="4" Text="Bottom ticks" TextAlignment="Right" Margin="2" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Grid.Row="4" x:Name="Slider4" Margin="8,4,6,2" TickPlacement="BottomRight"/>
                    <TextBlock Grid.Column="2" Grid.Row="4" Margin="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider4, StringFormat=F2}"/>

                    <TextBlock Grid.Column="0" Grid.Row="5" Text="Custom ticks" TextAlignment="Right" Margin="2,2,2,20" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Grid.Row="5" x:Name="Slider5" Margin="8,4,6,20" Ticks="0 5 6 7 10" TickPlacement="BottomRight"/>
                    <TextBlock Grid.Column="2" Grid.Row="5" Margin="2,2,2,20" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider5, StringFormat=F2}"/>
                </Grid>
                <Grid Margin="40,0,40,20" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="4" Text="Vertical Sliders" TextAlignment="Right" HorizontalAlignment="Center" FontWeight="Bold" Padding="0,0,0,8"/>

                    <Slider Grid.Row="1" Grid.Column="0" x:Name="SliderV0" Orientation="Vertical" TickPlacement="None" HorizontalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Value, ElementName=SliderV0, StringFormat=F2}" Margin="0,4,8,0"/>

                    <Slider Grid.Row="1" Grid.Column="1" x:Name="SliderV1" Orientation="Vertical" TickPlacement="TopLeft" HorizontalAlignment="Center" Margin="8,0" TickFrequency="2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Value, ElementName=SliderV1, StringFormat=F2}" Margin="0,4,8,0"/>

                    <Slider Grid.Row="1" Grid.Column="2" x:Name="SliderV2" Orientation="Vertical" TickPlacement="Both" HorizontalAlignment="Center" Margin="8,0" TickFrequency="2" IsDirectionReversed="True"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Value, ElementName=SliderV2, StringFormat=F2}" Margin="0,4,8,0"/>

                    <Slider Grid.Row="1" Grid.Column="3" x:Name="SliderV3" Orientation="Vertical" TickPlacement="BottomRight" HorizontalAlignment="Center" Margin="8,0" TickFrequency="2"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Value, ElementName=SliderV3, StringFormat=F2}" Margin="0,4,8,0"/>
                </Grid>
            </WrapPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/f0e1bdaa860f268012914157f91856b5" TabIndex="200">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Snap to ticks"/>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Grid.Row="7" x:Name="Slider7" IsSnapToTickEnabled="True" TickFrequency="2" LargeChange="4" TickPlacement="BottomRight"/>
                <TextBlock Grid.Column="1" Grid.Row="7" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider7, StringFormat=F2}"/>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/5c71b442808b40b0b9c4ac7ad3b59e61" TabIndex="300">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Move to point"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold">IsMoveToPointEnabled</Run>
                        <Run>property indicates whether the Thumb of a Slider moves immediately to the location of the mouse click.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="Slider8" IsMoveToPointEnabled="True" LargeChange="2"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Value, ElementName=Slider8, StringFormat=F2}"/>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/StackPanel.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="StackPanel"
    Tag="https://www.noesisengine.com/docs/Gui.Core._StackPanel.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The StackPanel is used to arrange items in a line, either horizontally or vertically."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/6c90ca58c59bdfabe42eff7ef41bd794" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Content layout"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Children items are stacked in the direction specified by the</Run>
            <Run FontWeight="Bold">Orientation</Run>
            <Run>property.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
          <TextBlock Text="Orientantion" VerticalAlignment="Center"/>
          <ComboBox x:Name="orientation" Width="200" Margin="15,0,0,0" SelectedIndex="1">
            <ComboBoxItem Content="Horizontal"/>
            <ComboBoxItem Content="Vertical"/>
          </ComboBox>
        </StackPanel>
        <Border Background="{DynamicResource Brush.Background.Popup}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
          <StackPanel Orientation="{Binding SelectedItem.Content, ElementName=orientation}" Width="350" Height="200">
            <Rectangle Fill="#7FFFEC" MinWidth="75" MinHeight="40" Margin="2"/>
            <Rectangle Fill="Turquoise" MinWidth="75" MinHeight="40" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" MinWidth="75" MinHeight="40" Margin="2"/>
            <Rectangle Fill="Teal" MinWidth="75" MinHeight="40" Margin="2"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>
)AEROXAML"},
    {"ControlGallery", "Samples/StatusBar.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="StatusBar"
    Tag="https://www.noesisengine.com/docs/Gui.Core._StatusBar.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="Represents a control that displays items and information in a horizontal bar in an application window. StatusBars are usually placed at the bottom of the application."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/428dc7b52c22423c12634fe9a330f89d" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Simple StatusBar"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Inside a StatusBar you can place any kind of controls, it is not limited to just text.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StatusBar Width="380">
          <StatusBarItem>
            <StackPanel Orientation="Horizontal">
              <Image Source="Images/floppy-disk.png" Height="12"/>
              <TextBlock Text="Item Saved" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StatusBarItem>
          <Separator/>
          <StatusBarItem DockPanel.Dock="Right">
            <TextBlock Text="{Binding Value, ElementName=DownloadProgress, StringFormat={}{0:F0} %}" VerticalAlignment="Center"/>
          </StatusBarItem>
          <StatusBarItem DockPanel.Dock="Right" VerticalContentAlignment="Stretch" Padding="4,3">
            <ProgressBar x:Name="DownloadProgress" Value="60" Width="80" Height="10"/>
          </StatusBarItem>
          <StatusBarItem Content="Building..." DockPanel.Dock="Right" Padding="0,5"/>
        </StatusBar>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/TabControl.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="TabControl"
    Tag="https://www.noesisengine.com/docs/Gui.Core._TabControl.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="TabControl provides the user with a collection of tabs that can be used to display several pages but only one at a time."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/3013afb35ef609a7bbf7836cd53f5676" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="SelectedContent"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Content being shown by the TabControl is defined by each TabItem and exposed through the</Run>
            <Run FontWeight="Bold">SelectedContent</Run>
            <Run>property.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <TabControl Width="360" Height="200">
          <TabItem Header="Page 1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Rectangle Grid.RowSpan="2" Margin="5" Fill="Teal"/>
              <Rectangle Grid.Row="0" Grid.Column="1" Margin="5" Fill="Turquoise"/>
              <Rectangle Grid.Row="0" Grid.Column="2" Margin="5" Fill="Aquamarine"/>
              <Rectangle Grid.Row="1" Grid.Column="1" Margin="5" Fill="CadetBlue"/>
              <Rectangle Grid.Row="1" Grid.Column="2" Margin="5" Fill="PaleTurquoise"/>
            </Grid>
          </TabItem>
          <TabItem Header="Page 2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.RowSpan="2" Margin="5" Fill="Turquoise" Height="60" VerticalAlignment="Top"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="5"
                         Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras at sem at tortor vulputate mattis. Proin eu ipsum sagittis, faucibus diam eu, ultricies felis. Nulla luctus lacus sapien, ac tempor elit consequat ut."/>
            </Grid>
          </TabItem>
          <TabItem Header="Page 3">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Text="TabControl" FontSize="20" FontWeight="Bold" Margin="5"/>
              <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="5"
                         Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras at sem at tortor vulputate mattis. Proin eu ipsum sagittis, faucibus diam eu, ultricies felis. Nulla luctus lacus sapien, ac tempor elit consequat ut."/>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/d9d30e38a824637247ee9cb185cc11fe" TabIndex="200">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="ItemsSource and item visualization"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>When TabControl is data bound to a collection of tabs, using its</Run>
            <Run FontWeight="Bold">ContentTemplate</Run>
            <Run>property you can define how the content for all tabs will be represented.</Run>
          </TextBlock>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Tab's header is rendered using TabControl's</Run>
            <Run FontWeight="Bold">ItemTemplate</Run>
            <Run>property.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Resources>
          <GradientStopCollection x:Key="list">
            <GradientStop x:Name="Tab1" Offset="10" Color="CadetBlue"/>
            <GradientStop x:Name="Tab2" Offset="20" Color="Turquoise"/>
            <GradientStop x:Name="Tab3" Offset="30" Color="Aquamarine"/>
          </GradientStopCollection>
        </StackPanel.Resources>
        <TabControl Width="360" Height="210" ItemsSource="{Binding Source={StaticResource list}}">
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="10" Margin="5">
                  <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding Color}"/>
                  </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Binding Offset}"/>
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="5"
                         Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras at sem at tortor vulputate mattis. Proin eu ipsum sagittis, faucibus diam eu, ultricies felis. Nulla luctus lacus sapien, ac tempor elit consequat ut."/>
                <Rectangle Grid.Row="1" Margin="5" Height="{Binding Offset}">
                  <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding Color}"/>
                  </Rectangle.Fill>
                </Rectangle>
              </Grid>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/TextBlock.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
