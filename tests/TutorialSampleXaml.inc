                </RadioButton>
                <Border Grid.Row="4" Grid.ColumnSpan="4" x:Name="Border" Height="50" BorderThickness="10" Margin="0,12,0,0" Background="Red" BorderBrush="Yellow"/>
            </Grid>
        </HeaderedContentControl>
