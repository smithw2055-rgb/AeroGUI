                    </TabItem>
                    <TabItem Header="Menus&amp;Bars">
                        <DockPanel Width="395">
                            <Menu DockPanel.Dock="Top">
                                <MenuItem Header="File">
                                    <MenuItem Header="New" InputGestureText="Ctrl+N"/>
