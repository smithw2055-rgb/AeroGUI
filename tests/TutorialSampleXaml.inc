                            <ScrollBar Orientation="Horizontal" Margin="0,10" />
                            <ScrollBar Orientation="Vertical" Height="80" Margin="0,10"/>
                            <ScrollViewer Width="100" Height="100" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFE7E7E7">
                                <Ellipse Fill="#8080FF" Width="200" Height="300"/>
