    {"ControlGallery", "Samples/ItemsControl.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ItemsControl"
    Tag="https://www.noesisengine.com/docs/Gui.Core._ItemsControl.html">

    <StackPanel>
        <TextBlock Style="{StaticResource SampleSectionDesc}" Text="Represents a control that can be used to present a collection of items."/>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/e66ecf77a99ede4fd60d659b4ba8034e" TabIndex="100">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Items"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run>By default an ItemsControl shows the collection of</Run>
                        <Run FontWeight="Bold">Items</Run>
                        <Run>as a vertical stack. Items can be of any type: a string, a number, a UIElement, etc.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Width="300" Padding="8,2">
                    This is a string inside an ItemsControl
                    <sys:Double>199.95</sys:Double>
                    <Rectangle Height="10" Fill="Red"/>
                    <Button Content="Button as an item" Margin="0,4" Padding="0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="Blue"/>
                        <TextBlock Text="A Panel with children" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                </ItemsControl>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/b65eb010ec540ed413b89384fc764e44" TabIndex="200">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="ItemsSource and item visualization"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold">ItemsSource</Run>
                        <Run>property can be used to bind a collection of items to the ItemsControl. Using an</Run>
                        <Run FontWeight="Bold">ObservableCollection&lt;T&gt;</Run>
                        <Run>as source will automatically update the UI when items get addded or removed from the collection.</Run>
                        <Run FontWeight="Bold">ItemsPanel</Run>
                        <Run>property is used to indicate how items are lay out inside the ItemsControl. And using</Run>
                        <Run FontWeight="Bold">ItemTemplate</Run>
                        <Run>property users can specify custom visualization for the data items.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Resources>
                    <GradientStopCollection x:Key="Colors">
                        <GradientStop Offset="0" Color="Red"/>
                        <GradientStop Offset="1" Color="OrangeRed"/>
                        <GradientStop Offset="2" Color="Orange"/>
                        <GradientStop Offset="3" Color="Yellow"/>
                        <GradientStop Offset="4" Color="Lime"/>
                        <GradientStop Offset="5" Color="Teal"/>
                        <GradientStop Offset="6" Color="Cyan"/>
                        <GradientStop Offset="7" Color="DodgerBlue"/>
                        <GradientStop Offset="8" Color="Blue"/>
                        <GradientStop Offset="9" Color="Purple"/>
                    </GradientStopCollection>
                    <ItemsPanelTemplate x:Key="PanelTemplate">
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                    <DataTemplate x:Key="ItemTemplate">
                        <StackPanel Margin="8,4,8,0">
                            <Rectangle Width="48" Height="24" Stroke="Black" StrokeThickness="2">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Color}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="{Binding Color}" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Grid.Resources>
                <ItemsControl ItemsSource="{Binding Source={StaticResource Colors}}" ItemsPanel="{StaticResource PanelTemplate}" ItemTemplate="{StaticResource ItemTemplate}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Width="340"/>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/77f67b615b42555e229d668f3e866b9d" TabIndex="300">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Virtualization"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run>In order to achieve virtualization of items for an ItemsControl the following conditions should be satisfied:</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022;</Run>
                        <Run>ItemsControl template must include a</Run>
                        <Run FontWeight="Bold">ScrollViewer</Run><Run>.</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022; ItemsPanel</Run>
                        <Run>property needs to use a virtualizing panel like</Run>
                        <Run FontWeight="Bold">VirtualizingStackPanel</Run><Run>.</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022; ScrollViewer.CanContentScroll</Run>
                        <Run>property must be set to</Run>
                        <Run FontWeight="Bold">True</Run><Run>.</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022;</Run>
                        <Run>ItemsControl must have scrollable area, usually by specifying a fixed height.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Resources>
                    <GradientStopCollection x:Key="Items">
                        <GradientStop Offset="1"/>
                        <GradientStop Offset="2"/>
                        <GradientStop Offset="3"/>
                        <GradientStop Offset="4"/>
                        <GradientStop Offset="5"/>
                        <GradientStop Offset="6"/>
                        <GradientStop Offset="7"/>
                        <GradientStop Offset="8"/>
                        <GradientStop Offset="9"/>
                        <GradientStop Offset="10"/>
                        <GradientStop Offset="11"/>
                        <GradientStop Offset="12"/>
                        <GradientStop Offset="13"/>
                        <GradientStop Offset="14"/>
                        <GradientStop Offset="15"/>
                        <GradientStop Offset="16"/>
                        <GradientStop Offset="17"/>
                        <GradientStop Offset="18"/>
                        <GradientStop Offset="19"/>
                        <GradientStop Offset="20"/>
                        <GradientStop Offset="21"/>
                        <GradientStop Offset="22"/>
                        <GradientStop Offset="23"/>
                        <GradientStop Offset="24"/>
                        <GradientStop Offset="25"/>
                        <GradientStop Offset="26"/>
                        <GradientStop Offset="27"/>
                        <GradientStop Offset="28"/>
                        <GradientStop Offset="29"/>
                        <GradientStop Offset="30"/>
                    </GradientStopCollection>
                    <ItemsPanelTemplate x:Key="PanelTemplate">
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                    <DataTemplate x:Key="ItemTemplate">
                        <TextBlock Text="{Binding Offset, StringFormat='Data Item {0}'}"/>
                    </DataTemplate>
                    <ControlTemplate x:Key="VirtualizedItems" TargetType="ItemsControl">
                        <ScrollViewer BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Grid.Resources>
                <ItemsControl ItemsSource="{Binding Source={StaticResource Items}}" ItemsPanel="{StaticResource PanelTemplate}" ItemTemplate="{StaticResource ItemTemplate}" Template="{StaticResource VirtualizedItems}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Width="150" Height="80" Padding="8,4"/>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/ListBox.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ListBox"
    Tag="https://www.noesisengine.com/docs/Gui.Core._ListBox.html">

    <StackPanel>
        <TextBlock Style="{StaticResource SampleSectionDesc}" Text="A ListBox allows users to select one or more options from a list of items. Each item could be presented as a simple text or use a template to customize how it should look."/>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/830918c271906a797078364465dae091" TabIndex="100">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="SelectionMode and selection properties"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run>Using</Run>
                        <Run FontWeight="Bold">SelectionMode</Run>
                        <Run>property you can specify the selection behavior for the list:</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022; Single</Run>
                        <Run>if only one item at a time can be selected.</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022; Extended</Run>
                        <Run>allows multiple selected items by holding the SHIFT (range selection) or CTRL (toggle selection) keys.</Run><LineBreak/>
                        <Run/> <Run FontWeight="Bold">&#x2022; Multiple</Run>
                        <Run>to select multiple items without holding down a modifier key.</Run>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run>User can bind to</Run>
                        <Run FontWeight="Bold">SelectedIndex</Run><Run>,</Run>
                        <Run FontWeight="Bold">SelectedItem</Run> <Run>or</Run>
                        <Run FontWeight="Bold">SelectedValue</Run>
                        <Run>to be notified when selection changes.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ListBox x:Name="List1" SelectionMode="{Binding SelectedItem.Content, ElementName=SelectionMode}" SelectedValuePath="Content" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Width="100" Height="150">
                    <ListBoxItem Content="Item 0"/>
                    <ListBoxItem Content="Item 1"/>
                    <ListBoxItem Content="Item 2"/>
                    <ListBoxItem Content="Item 3"/>
                    <ListBoxItem Content="Item 4"/>
                    <ListBoxItem Content="Item 5"/>
                    <ListBoxItem Content="Item 6"/>
                    <ListBoxItem Content="Item 7"/>
                    <ListBoxItem Content="Item 8"/>
                    <ListBoxItem Content="Item 9"/>
                </ListBox>
                <Grid Margin="20,0,0,0" Width="250" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="SelectionMode:" FontWeight="Bold"/>
                    <ComboBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="SelectionMode" SelectedIndex="0" Margin="0,5,0,0" Width="150" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Single"/>
                        <ComboBoxItem Content="Extended"/>
                        <ComboBoxItem Content="Multiple"/>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SelectedIndex:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedIndex, ElementName=List1}" Margin="10,10,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SelectedItem:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem, ElementName=List1}" Margin="10,10,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="SelectedValue:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedValue, ElementName=List1}" Margin="10,10,0,0"/>
                </Grid>
            </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/02b5c58205763877720f4e80930076b1" TabIndex="200">
            <HeaderedContentControl.Header>
                <TextBlock Style="{StaticResource SampleSectionTitle}" Text="ItemsSource and item visualization"/>
            </HeaderedContentControl.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <GradientStopCollection x:Key="Colors">
                        <GradientStop Offset="0" Color="Red"/>
                        <GradientStop Offset="1" Color="OrangeRed"/>
                        <GradientStop Offset="2" Color="Orange"/>
                        <GradientStop Offset="3" Color="Yellow"/>
                        <GradientStop Offset="4" Color="Lime"/>
                        <GradientStop Offset="5" Color="Teal"/>
                        <GradientStop Offset="6" Color="Cyan"/>
                        <GradientStop Offset="7" Color="DodgerBlue"/>
                        <GradientStop Offset="8" Color="Blue"/>
                        <GradientStop Offset="9" Color="Purple"/>
                    </GradientStopCollection>
                    <ItemsPanelTemplate x:Key="PanelTemplate">
                        <WrapPanel ItemWidth="60" ItemHeight="60"/>
                    </ItemsPanelTemplate>
                    <DataTemplate x:Key="ItemTemplate">
                        <Rectangle Width="35" Height="35" Stroke="Black" StrokeThickness="2">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding Color}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                    <DataTemplate x:Key="SelectedItemTemplate">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Offset:" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Offset}" Margin="10,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Color (HEX):" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Color}" Margin="10,10,0,0"/>
                            <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Height="40" Margin="0,10,0,0">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Color}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </DataTemplate>
                </StackPanel.Resources>
                <ListBox x:Name="List2" ItemsSource="{Binding Source={StaticResource Colors}}" ItemsPanel="{StaticResource PanelTemplate}" ItemTemplate="{StaticResource ItemTemplate}" SelectedIndex="0" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Width="130" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <StackPanel Margin="20,0,0,0" Width="220" VerticalAlignment="Top">
                    <TextBlock Text="SELECTION" Margin="0,5,0,10"/>
                    <ContentPresenter Content="{Binding SelectedItem, ElementName=List2}" ContentTemplate="{StaticResource SelectedItemTemplate}"/>
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/ListView.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ListView"
    Tag="https://www.noesisengine.com/docs/Gui.Controls._ListView.html">

    <StackPanel>
        <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The ListView control provides a flexible way to display a collection of data in rows and columns."/>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/e43c4c3dd3f28a27e6153581ca12fc70" TabIndex="100">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="GridView"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run>Using a</Run>
                        <Run FontWeight="Bold">GridView</Run>
                        <Run>object in the</Run>
                        <Run FontWeight="Bold">View</Run>
                        <Run>property, the user can define the appereance of column headers and content. Without a View it will behave exactly as a ListBox.</Run>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold" >HeaderContainerStyle</Run>
                        <Run>and</Run>
                        <Run FontWeight="Bold">HeaderTemplate</Run>
                        <Run>properties are used to customize the look of column headers.</Run>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold">CellTemplate</Run>
                        <Run>property can be used to specify how to display the contents of a column cell. Shouldn't be used at the same time as</Run>
                        <Run FontWeight="Bold">DisplayMemberBinding</Run>
                        <Run>property, which has priority.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Resources>
                    <Grid x:Key="Container">
                        <ContentControl Content="Carrot" TabIndex="1" Tag="1kg bag" MinWidth="0.69" MinHeight="35"/>
                        <ContentControl Content="Broccoli" TabIndex="2" Tag="450gr unit" MinWidth="1.30" MinHeight="19"/>
                        <ContentControl Content="Asparagus" TabIndex="3" Tag="300gr pkg" MinWidth="2.40" MinHeight="15"/>
                        <ContentControl Content="Cauliflower" TabIndex="4" Tag="1,25kg unit" MinWidth="2.38" MinHeight="8"/>
                        <ContentControl Content="Corn" TabIndex="5" Tag="400gr pkg" MinWidth="1.10" MinHeight="24"/>
                        <ContentControl Content="Cucumber" TabIndex="6" Tag="1,25kg bag" MinWidth="1.59" MinHeight="31"/>
                        <ContentControl Content="Eggplant" TabIndex="7" Tag="350gr unit" MinWidth="0.61" MinHeight="42"/>
                        <ContentControl Content="Green Pepper" TabIndex="8" Tag="120gr unit" MinWidth="0.23" MinHeight="48"/>
                        <ContentControl Content="Red Pepper" TabIndex="9" Tag="390gr unit" MinWidth="0.76" MinHeight="25"/>
                        <ContentControl Content="Lettuce" TabIndex="10" Tag="1 unit" MinWidth="1.20" MinHeight="27"/>
                        <ContentControl Content="Mushroom" TabIndex="11" Tag="300gr pkg" MinWidth="1.17" MinHeight="16"/>
                        <ContentControl Content="Onion" TabIndex="12" Tag="1kg bag" MinWidth="1.30" MinHeight="18"/>
                        <ContentControl Content="Potato" TabIndex="13" Tag="3kg bag" MinWidth="3.95" MinHeight="14"/>
                        <ContentControl Content="Pumpkin" TabIndex="14" Tag="2,10kg unit" MinWidth="3.31" MinHeight="9"/>
                        <ContentControl Content="Tomato" TabIndex="15" Tag="2kg bag" MinWidth="2.60" MinHeight="21"/>
                    </Grid>
                    <AlternationConverter x:Key="RowBackgroundConverter">
                        <SolidColorBrush Color="#106090B0"/>
                        <SolidColorBrush Color="#306090B0"/>
                    </AlternationConverter>
                    <Style x:Key="ItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Background" Value="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}, Converter={StaticResource RowBackgroundConverter}}"/>
                    </Style>
                    <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                        <Setter Property="Background" Value="#606090B0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                    <Style x:Key="IdHeaderStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource HeaderStyle}">
                        <Setter Property="Background" Value="#806090B0"/>
                    </Style>
                    <DataTemplate x:Key="StockTemplate">
                        <TextBlock x:Name="Txt" Text="{Binding MinHeight}" Foreground="{DynamicResource Brush.Foreground.Normal}"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding MinHeight}" Value="0">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="1">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="2">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="3">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="4">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="5">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="6">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="7">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="8">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="9">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinHeight}" Value="0">
                                <Setter Property="Foreground" Value="Red" TargetName="Txt"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Grid.Resources>
                <ListView ItemsSource="{Binding Children, Source={StaticResource Container}}" ItemContainerStyle="{StaticResource ItemStyle}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" AlternationCount="2" Width="380" Height="250">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                            <GridViewColumn DisplayMemberBinding="{Binding TabIndex, StringFormat=#{0}}" Header="ID" Width="40" HeaderContainerStyle="{StaticResource IdHeaderStyle}"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Content}" Header="Product Name" Width="120"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Tag}" Header="Quantity" Width="85"/>
                            <GridViewColumn DisplayMemberBinding="{Binding MinWidth, StringFormat=C2}" Header="Unit Price" Width="80"/>
                            <GridViewColumn Header="Stock" Width="50" CellTemplate="{StaticResource StockTemplate}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/Menu.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="Menu"
    Tag="https://www.noesisengine.com/docs/Gui.Core._Menu.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The Menu simplifies the creation of basic applications by providing a set of menus at the top of the app window."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/16357af0503441ae267f53c24609c5a0" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="A simple Menu"/>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Menu VerticalAlignment="Top" Width="360">
          <MenuItem Header="File">
            <MenuItem Header="New"/>
            <MenuItem Header="Open"/>
            <MenuItem Header="Save"/>
            <MenuItem Header="Exit"/>
          </MenuItem>
          <MenuItem Header="Edit">
            <MenuItem Header="Cut"/>
            <MenuItem Header="Copy"/>
            <MenuItem Header="Paste"/>
          </MenuItem>
          <MenuItem Header="Help">
            <MenuItem Header="About"/>
          </MenuItem>
        </Menu>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/69c4b042d5c995c8610f1786dd77af39" TabIndex="200">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Key shortcuts"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>To add keyboard shortcuts to specific Menu items user must define command and key bindings. The property</Run>
            <Run FontWeight="Bold">InputgestureText</Run>
            <Run>only represents an informative text.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!--<Grid.CommandBindings>
          <CommandBinding Command="ApplicationCommands.New" Executed="OnNewDocument"/>
          <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenDocument"/>
          <CommandBinding Command="ApplicationCommands.Save" CanExecute="OnCanSaveDocument" Executed="OnSaveDocument"/>
          <CommandBinding Command="ApplicationCommands.Help" Executed="OnShowHelp"/>
        </Grid.CommandBindings>-->
        <Grid.InputBindings>
          <KeyBinding Command="ApplicationCommands.New" Key="N" Modifiers="Ctrl"/>
          <KeyBinding Command="ApplicationCommands.Open" Key="O" Modifiers="Ctrl"/>
          <KeyBinding Command="ApplicationCommands.Save" Key="S" Modifiers="Ctrl"/>
          <KeyBinding Command="ApplicationCommands.Help" Key="H" Modifiers="Ctrl"/>
        </Grid.InputBindings>
        <Menu VerticalAlignment="Top" Width="360">
          <MenuItem Header="File">
