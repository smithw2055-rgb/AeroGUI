    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/bd0fc99823f0e8c80c8816c8ed4f9fb1" TabIndex="300">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Submenus and toggle entries"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>A</Run>
            <Run FontWeight="Bold">Separator</Run>
            <Run>can be used to group menu entries in different blocks.</Run>
          </TextBlock>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>An entry can be a toggle option by setting</Run>
            <Run FontWeight="Bold">IsCheckable</Run>
            <Run>property to true.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Menu VerticalAlignment="Top" Width="360">
          <MenuItem Header="File">
            <MenuItem Header="New">
              <MenuItem Header="Project"/>
              <MenuItem Header="Document"/>
            </MenuItem>
            <MenuItem Header="Open"/>
            <MenuItem Header="Save"/>
            <Separator/>
            <MenuItem Header="Exit"/>
          </MenuItem>
          <MenuItem Header="Edit">
            <MenuItem Header="Cut"/>
            <MenuItem Header="Copy"/>
            <MenuItem Header="Paste"/>
            <Separator/>
            <MenuItem Header="Find and Replace">
              <MenuItem Header="Find"/>
              <MenuItem Header="Replace"/>
              <Separator/>
              <MenuItem Header="Find in Files"/>
              <MenuItem Header="Replace in Files"/>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="View">
            <MenuItem Header="Show ToolBar" IsCheckable="True"/>
            <MenuItem Header="Show Console" IsCheckable="True"/>
          </MenuItem>
          <MenuItem Header="Help">
            <MenuItem Header="About"/>
          </MenuItem>
        </Menu>
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/f5b2438ef900bbc6f4bdac05d8409d83" TabIndex="400">
      <HeaderedContentControl.Header>
        <StackPanel>
