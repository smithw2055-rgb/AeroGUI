    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Checked" SourceName="Casual">
            <b:ControlStoryboardAction Storyboard="{StaticResource ActivateCasual}"/>
        </b:EventTrigger>
        <b:EventTrigger EventName="Checked" SourceName="Normal">
            <b:ControlStoryboardAction Storyboard="{StaticResource ActivateNormal}"/>
        </b:EventTrigger>
        <b:EventTrigger EventName="Checked" SourceName="Expert">
            <b:ControlStoryboardAction Storyboard="{StaticResource ActivateExpert}"/>
        </b:EventTrigger>
        <b:DataTrigger Binding="{Binding State}" Value="{x:Static local:State.Start}">
            <b:ChangePropertyAction TargetName="Casual" PropertyName="MinHeight" Value="1"/>
            <b:ControlStoryboardAction Storyboard="{StaticResource FadeIn}"/>
        </b:DataTrigger>
        <b:StoryboardCompletedTrigger Storyboard="{StaticResource FadeIn}">
            <noesis:SetFocusAction TargetName="Casual"/>
            <b:ChangePropertyAction TargetName="Casual" PropertyName="MinHeight" Value="0"/>
        </b:StoryboardCompletedTrigger>
        <b:DataTrigger Binding="{Binding State}" Comparison="NotEqual" Value="{x:Static local:State.Start}">
            <b:ControlStoryboardAction Storyboard="{StaticResource FadeOut}"/>
        </b:DataTrigger>
        <b:KeyTrigger Key="Esc" ActiveOnFocus="True">
            <b:PlaySoundAction Source="Sounds/WaterDropBig.mp3" Volume="0.5"/>
            <b:InvokeCommandAction Command="{Binding Back}"/>
        </b:KeyTrigger>
    </b:Interaction.Triggers>

    <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5">
        <Viewbox>
            <Grid Width="1300" Height="900">
                <noesis:Element.Transform3D>
                    <noesis:CompositeTransform3D RotationY="-8"/>
                </noesis:Element.Transform3D>
              <Grid x:Name="ContentRoot">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="MenuTitle" Orientation="Vertical" HorizontalAlignment="Left">
                    <Viewbox x:Name="Logo" Stretch="Uniform" Height="100" Margin="0,-9,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource NoesisLogoGeometry}" Fill="{StaticResource NoesisLogoBlue}" Stretch="Uniform"/>
                            <Path Data="{StaticResource NoesisTextGeometry}" Fill="White" Stretch="Uniform" Margin="40,0,0,0" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource NoesisGuiTextGeometry}" Fill="{StaticResource NoesisLogoBlue}" Stretch="Uniform" Margin="40,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Text="MENU DEMO" FontSize="50" HorizontalAlignment="Right" Margin="0,-19,-2,0" Foreground="{StaticResource TransparentWhiteBrush95}"/>
                </StackPanel>
                <Grid x:Name="MenuOptions" Grid.Row="1" Width="640" Margin="0,30,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Cycle" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Margin="-20,0,0,108">
