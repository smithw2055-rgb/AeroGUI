        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=enable}" Height="500">
            <Border Margin="10,0" Padding="20">
