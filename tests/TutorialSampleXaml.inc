        FontSize="{DynamicResource Font.Size.Normal}"
        UseLayoutRounding="True">

    <Grid>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
            <CheckBox x:Name="enable" Content="Enable controls" IsChecked="True" VerticalAlignment="Top"/>
            <ComboBox x:Name="tabpos" SelectedIndex="0">
                <ComboBoxItem Content="{x:Static Dock.Top}"/>
                <ComboBoxItem Content="{x:Static Dock.Bottom}"/>
                <ComboBoxItem Content="{x:Static Dock.Left}"/>
                <ComboBoxItem Content="{x:Static Dock.Right}"/>
