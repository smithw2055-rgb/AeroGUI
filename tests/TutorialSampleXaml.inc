                                <ContentControl Style="{StaticResource MenuToolTipStyle}" Content="For experienced players only." IsEnabled="{Binding IsKeyboardFocused, ElementName=Expert}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
