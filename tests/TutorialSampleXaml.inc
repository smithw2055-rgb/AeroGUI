                  Data="F1M247,0.2L27.1,0.2 25.7,1.6 248.4,1.6z"
                  Fill="{TemplateBinding Background}" Stretch="Fill"/>
            <Path x:Name="bd" Grid.Column="0" Grid.ColumnSpan="2" Width="259.956" Height="87.223" Margin="0,-0.423,-31.356,0"
