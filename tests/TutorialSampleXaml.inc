                <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="You can set the Font and Size of this text." TextWrapping="Wrap" FontFamily="{Binding Text, ElementName=Font}" FontSize="{Binding Text, ElementName=FontSizes}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/ContextMenu.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ContextMenu"
    Tag="https://www.noesisengine.com/docs/Gui.Core._ContextMenu.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="A ContextMenu displays a menu that can be dismissed by clicking or tapping off of it. Use it to let the user choose from a contextual list of simple commands or options."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/7b79e7ce0eeeca2a3c07803fa64fa154" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="A simple ContextMenu"/>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{DynamicResource Brush.Header.Normal}" Width="360" Padding="20">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Option 1"/>
              <MenuItem Header="Option 2"/>
              <MenuItem Header="Option 3"/>
            </ContextMenu>
          </Border.ContextMenu>
          <TextBlock Text="Right click to open Context Menu" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Border>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/9e31c0e860b73aa44fea16564030c899" TabIndex="200">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Submenus and toggle entries"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>A</Run>
            <Run FontWeight="Bold">Separator</Run>
            <Run>can be used to group menu entries in different blocks.</Run>
          </TextBlock>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>An entry can be a toggle option by setting</Run>
            <Run FontWeight="Bold">IsCheckable</Run>
            <Run>property to true.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{DynamicResource Brush.Header.Normal}" Width="360" Padding="20">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="View">
                <MenuItem Header="Large icons"/>
                <MenuItem Header="Small icons"/>
                <MenuItem Header="List"/>
                <MenuItem Header="Details"/>
              </MenuItem>
              <MenuItem Header="Sort by">
                <MenuItem Header="Name"/>
                <MenuItem Header="Date"/>
                <MenuItem Header="Type"/>
              </MenuItem>
              <MenuItem Header="Refresh"/>
              <Separator/>
              <MenuItem Header="Pin to TaskBar" IsCheckable="True"/>
            </ContextMenu>
          </Border.ContextMenu>
          <TextBlock Text="Right click to open Context Menu" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Border>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/bcfae6b889e85d5f7491fb8a1801f80d" TabIndex="300">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Click event"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Each MenuItem provides a</Run>
            <Run FontWeight="Bold">Click</Run>
            <Run>event that can be used to perform actions over the target object.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Resources>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu">
              <Setter.Value>
                <ContextMenu>
                  <MenuItem Header="Remove">
                    <b:Interaction.Triggers>
                      <b:EventTrigger EventName="Click">
                        <b:RemoveElementAction TargetObject="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                      </b:EventTrigger>
                    </b:Interaction.Triggers>
                  </MenuItem>
                </ContextMenu>
              </Setter.Value>
            </Setter>
          </Style>
        </StackPanel.Resources>
        <TextBlock Text="Use contextual menu to remove items from the list." Margin="0,0,0,10"/>
        <ListBox Width="360" Height="200" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
          <ListBoxItem Content="ListBox Item 1"/>
          <ListBoxItem Content="ListBox Item 2"/>
          <ListBoxItem Content="ListBox Item 3"/>
          <ListBoxItem Content="ListBox Item 4"/>
          <ListBoxItem Content="ListBox Item 5"/>
          <ListBoxItem Content="ListBox Item 6"/>
          <ListBoxItem Content="ListBox Item 7"/>
          <ListBoxItem Content="ListBox Item 8"/>
          <ListBoxItem Content="ListBox Item 9"/>
        </ListBox>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/DockPanel.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="DockPanel"
    Tag="https://www.noesisengine.com/docs/Gui.Core._DockPanel.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The DockPanel defines an area where you can arrange child elements either horizontally or vertically, relative to each other."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/e6a94a8e1249ee3b2827c3f146960fc7" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Content layout"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run FontWeight="Bold">Dock</Run>
            <Run>attached property changes the position of an element relative to other elements in the same DockPanel.</Run>
          </TextBlock>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Using property</Run>
            <Run FontWeight="Bold">LastChildFill</Run>
            <Run>the last child element of the DockPanel will fill the remaining space, regardless of any other dock value set on that element.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
          <TextBlock Text="Dock" VerticalAlignment="Center"/>
          <ComboBox x:Name="dock" Width="120" Margin="10,0,0,0" SelectedIndex="0">
            <ComboBoxItem Content="Left"/>
            <ComboBoxItem Content="Top"/>
            <ComboBoxItem Content="Right"/>
            <ComboBoxItem Content="Bottom"/>
          </ComboBox>
          <CheckBox x:Name="fill" Content="Fill remaining space" IsChecked="False" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Background="{DynamicResource Brush.Background.Popup}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
          <DockPanel Width="350" Height="240" LastChildFill="{Binding IsChecked, ElementName=fill}">
            <Border Background="Turquoise" Padding="10" DockPanel.Dock="Top" Margin="2">
              <TextBlock Text="Top" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="LightSeaGreen" Padding="10" DockPanel.Dock="Bottom" Margin="2">
              <TextBlock Text="Bottom" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="Teal" Padding="20,10" DockPanel.Dock="Left" Margin="2">
              <TextBlock Text="Left" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="Teal" Padding="20,10" DockPanel.Dock="Right" Margin="2">
              <TextBlock Text="Right" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="LightSeaGreen" Padding="10" DockPanel.Dock="Top" Margin="2">
              <TextBlock Text="Top" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="Turquoise" Padding="20,10" DockPanel.Dock="{Binding SelectedItem.Content, ElementName=dock}" Margin="2">
              <TextBlock Text="{Binding SelectedItem.Content, ElementName=dock}" FontSize="16" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </DockPanel>
        </Border>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>
)AEROXAML"},
    {"ControlGallery", "Samples/Effects.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
