                                        <GradientStop Offset="1" Color="Orange"/>
                                        <GradientStop Offset="2" Color="Yellow"/>
                                        <GradientStop Offset="3" Color="Lime"/>
                                        <GradientStop Offset="4" Color="Green"/>
                                        <GradientStop Offset="5" Color="Cyan"/>
                                        <GradientStop Offset="6" Color="Blue"/>
                                        <GradientStop Offset="7" Color="Magenta"/>
                                        <GradientStop Offset="8" Color="Purple"/>
                                    </GradientStopCollection>
                                </StackPanel.Resources>
                                <ListBox Width="150" Margin="10,0">
                                    <ListBoxItem Content="ListBox Item 1" />
                                    <ListBoxItem Content="ListBox Item 2" />
                                    <ListBoxItem Content="ListBox Item 3" />
                                    <ListBoxItem Content="ListBox Item 4" />
                                    <ListBoxItem Content="ListBox Item 5" />
                                    <ListBoxItem Content="ListBox Item 6" />
                                    <ListBoxItem Content="ListBox Item 7" />
                                    <ListBoxItem Content="ListBox Item 8" />
                                    <ListBoxItem Content="ListBox Item 9" />
                                </ListBox>
                                <ListView ItemsSource="{StaticResource list}" Width="300">
