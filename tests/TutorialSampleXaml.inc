                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Sliders">
                        <StackPanel Margin="10" MinWidth="100">
                            <ProgressBar Value="{Binding Value, ElementName=slider1}" Minimum="0" Maximum="100" Margin="0,10" />
                            <ProgressBar Value="40" Minimum="0" Maximum="100" IsIndeterminate="True" />
