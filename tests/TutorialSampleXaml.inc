    {"ControlGallery", "Samples/ToggleButton.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ToggleButton"
    Tag="https://www.noesisengine.com/docs/Gui.Core._ToggleButton.html">

    <StackPanel>
        <TextBlock Style="{StaticResource SampleSectionDesc}" Text="A ToggleButton looks like a normal Button, but works as a CheckBox. It typically has two states, Checked or Unchecked, but can be indeterminate if the IsThreeState property is true."/>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/c693ea7b5c8d8b9b00ca5944abf4b320" TabIndex="100">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="IsChecked"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold">IsChecked</Run>
                        <Run>property indicates if the ToggleButton is checked. When set to true the</Run>
                        <Run FontWeight="Bold">Checked</Run>
                        <Run>event is raised, and</Run>
                        <Run FontWeight="Bold">Unchecked</Run>
                        <Run>event when set to false.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Duration="0:0:0.5" Storyboard.TargetName="CheckedRect1" Storyboard.TargetProperty="Fill.Color" From="#00ADFF2F" To="#FFADFF2F"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Duration="0:0:0.5" Storyboard.TargetName="UncheckedRect1" Storyboard.TargetProperty="Fill.Color" From="#00ADFF2F" To="#FFADFF2F"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="Button1" Content="ToggleButton"/>
                <TextBlock Grid.Column="1" Text="{Binding IsChecked, ElementName=Button1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Rectangle Fill="DodgerBlue" Width="40"/>
                    <Rectangle Fill="#FFADFF2F" x:Name="CheckedRect1"/>
                </Grid>
                <Grid Grid.Column="3" Margin="8,0,0,0">
                    <Rectangle Fill="OrangeRed" Width="40"/>
                    <Rectangle Fill="#FFADFF2F" x:Name="UncheckedRect1"/>
                </Grid>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/0abfb87099885156b1e151de30862dba" TabIndex="200">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="IsThreeState"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run FontWeight="Bold">IsThreeState</Run>
                        <Run>property determines if the ToggleButton supports two or three states. When true, the IsChecked property can be set to</Run>
                        <Run FontWeight="Bold">null</Run>
                        <Run>as third state.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Duration="0:0:0.5" Storyboard.TargetName="CheckedRect2" Storyboard.TargetProperty="Fill.Color" From="#00ADFF2F" To="#FFADFF2F"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="ToggleButton.Indeterminate">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Duration="0:0:0.5" Storyboard.TargetName="IndeterminateRect2" Storyboard.TargetProperty="Fill.Color" From="#00ADFF2F" To="#FFADFF2F"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Duration="0:0:0.5" Storyboard.TargetName="UncheckedRect2" Storyboard.TargetProperty="Fill.Color" From="#00ADFF2F" To="#FFADFF2F"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="Button2" Content="ToggleButton" IsThreeState="True"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding IsChecked, ElementName=Button2}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=Button2}" Value="{x:Null}">
                                    <Setter Property="Text" Value="NULL"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Rectangle Fill="DodgerBlue" Width="40"/>
                    <Rectangle Fill="#FFADFF2F" x:Name="CheckedRect2"/>
                </Grid>
                <Grid Grid.Column="3" Margin="8,0,0,0">
                    <Rectangle Fill="Gray" Width="40"/>
                    <Rectangle Fill="#FFADFF2F" x:Name="IndeterminateRect2"/>
                </Grid>
                <Grid Grid.Column="4" Margin="8,0,0,0">
                    <Rectangle Fill="OrangeRed" Width="40"/>
                    <Rectangle Fill="#FFADFF2F" x:Name="UncheckedRect2"/>
                </Grid>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/b5e9c4cce253496046ed4f8f85532a8b" TabIndex="300">
            <HeaderedContentControl.Header>
                <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Custom style"/>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Resources>
                    <SolidColorBrush x:Key="Brush.OuterBorder" Color="#FF919596"/>
                    <SolidColorBrush x:Key="Brush.OuterBorderInset" Color="#FFB0B1B3"/>
                    <SolidColorBrush x:Key="Brush.InnerBorder" Color="#FFD4D6D5"/>
                    <SolidColorBrush x:Key="Brush.SwitchThumbBg" Color="#FF878586"/>
                    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#FFAFAFAF"/>
                    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#FFCBCBCB"/>
                    <LinearGradientBrush x:Key="Brush.SwitchThumb" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFE5E5E5" Offset="0"/>
                        <GradientStop Color="#FFAFAFAF" Offset="0.97"/>
                        <GradientStop Color="#00AFAFAF" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.DownShadow" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A5000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.LeftShadow" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#CC000000" Offset="0.5"/>
                        <GradientStop Color="#00000000"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Brush.RightShadow" StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#CC000000" Offset="0.5"/>
                        <GradientStop Color="#00000000"/>
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="Brush.InnerShadow">
                        <GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#33000000" Offset="1"/>
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="Brush.InnerShadowDark">
                        <GradientStop Color="#17000000" Offset="0.5"/>
                        <GradientStop Color="#33000000" Offset="1"/>
                    </RadialGradientBrush>
                    <ControlTemplate x:Key="Template.ToggleButton.Switch" TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.1" To="MouseOver">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.2">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Storyboard.TargetName="border">
                                                <EasingColorKeyFrame KeyTime="0" Value="#FFFAFAFA"/>
                                            </ColorAnimationUsingKeyFrames>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Storyboard.TargetName="border">
                                                <EasingColorKeyFrame KeyTime="0" Value="#FFBFBFBF"/>
                                            </ColorAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.4" To="Checked">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.4" To="1" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="SwitchSpace">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Checked" GeneratedDuration="0:0:0.5">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.5" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="SwitchSpace">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="SwitchSpace">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="OffGroup">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Brush.OuterBorder}" Background="Silver">
                                <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Brush.OuterBorderInset}" Padding="6">
                                    <Border CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Brush.InnerBorder}">
                                        <Grid>
                                            <Grid x:Name="OnGroup">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="1" Background="{TemplateBinding Background}" Grid.ColumnSpan="2"/>
                                                <Border CornerRadius="1" Grid.ColumnSpan="2" Background="{StaticResource Brush.InnerShadow}"/>
                                                <Viewbox>
                                                    <TextBlock Text="ON" Margin="2" Foreground="White" Width="32" TextAlignment="Center"/>
                                                </Viewbox>
                                            </Grid>
                                            <Grid x:Name="OffGroup">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Decorator x:Name="SwitchWidth"/>
                                                <Border CornerRadius="1" Background="{TemplateBinding Background}" Grid.ColumnSpan="2"/>
                                                <Border CornerRadius="1" Background="#B2000000" Grid.ColumnSpan="2"/>
                                                <Border CornerRadius="1" Grid.ColumnSpan="2" Background="{StaticResource Brush.InnerShadow}"/>
                                                <Viewbox Grid.Column="1">
                                                    <TextBlock Text="OFF" Margin="2" Foreground="#7FFFFFFF" Width="32" TextAlignment="Center"/>
                                                </Viewbox>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Decorator x:Name="SwitchSpace" Width="{Binding ActualWidth, ElementName=SwitchWidth}">
                                                    <Decorator.LayoutTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="0"/>
                                                            <SkewTransform/>
                                                            <RotateTransform/>
                                                            <TranslateTransform/>
                                                        </TransformGroup>
                                                    </Decorator.LayoutTransform>
                                                </Decorator>
                                                <Border Width="{Binding ActualWidth, ElementName=SwitchWidth}">
                                                    <Grid>
                                                        <Border CornerRadius="4" BorderThickness="0,6,0,6"  Margin="-2,0,-2,-8" VerticalAlignment="Bottom"
                                                    BorderBrush="{StaticResource Brush.DownShadow}"/>
                                                        <Border CornerRadius="4" BorderThickness="2,0,2,0"  Margin="-4,-4,-4,-3" HorizontalAlignment="Left"
                                                     BorderBrush="{StaticResource Brush.LeftShadow}"/>
                                                        <Border CornerRadius="4" BorderThickness="2,0,2,0"  Margin="-4,-4,-4,-3" HorizontalAlignment="Right"
                                                    BorderBrush="{StaticResource Brush.RightShadow}"/>
                                                        <Border CornerRadius="2" Margin="-3,-5,-3,-4" Background="{StaticResource Brush.SwitchThumbBg}"/>
                                                        <Border x:Name="border" Margin="-3,-5,-3,-4" CornerRadius="2,2,4,4" Background="{StaticResource Brush.SwitchThumb}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                    <Style x:Key="Style.ToggleButton.Switch" TargetType="{x:Type ToggleButton}">
                        <Setter Property="Background" Value="#1ea6e4"/>
                        <Setter Property="Template" Value="{StaticResource Template.ToggleButton.Switch}"/>
                        <Setter Property="FontFamily" Value="Fonts/#Aero Matics"/>
                        <Setter Property="ClickMode" Value="Press"/>
                    </Style>
                </Grid.Resources>
                <ToggleButton Width="150" Height="50" Padding="10,5"
                Style="{StaticResource Style.ToggleButton.Switch}" Background="#FF0CC736"/>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/ToolBar.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ToolBar"
    Tag="https://www.noesisengine.com/docs/Gui.Core._ToolBar.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The ToolBar control provides a container for a group of commands or controls. ToolBars are usually placed under the top Menu bar of the application."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/49e710fc3c7b3cbdfc8b108bea243018" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Header"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>With the</Run>
            <Run FontWeight="Bold">Header</Run>
            <Run>property you can identify different ToolBars if you need to clarify its target usage.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ToolBar Width="360" Header="Project"/>
        <ToolBar Width="360" Header="Document"/>
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/d2fd25d0d99492e4402c514b00a13cdc" TabIndex="200">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Buttons"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Inside a ToolBar all button types are usually shown without a background. And toggle buttons like CheckBox and RadioButton will just show a border when they are checked.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <ToolBar Width="360">
          <Button ToolTip="New">
            <Image Source="Images/file.png" Height="21"/>
          </Button>
          <Button ToolTip="Open">
            <Image Source="Images/folder-open.png" Height="21"/>
          </Button>
          <Button ToolTip="Save">
            <Image Source="Images/floppy-disk.png" Height="21"/>
          </Button>
          <Separator/>
          <CheckBox ToolTip="Show search box">
            <Image Source="Images/search.png" Height="21"/>
          </CheckBox>
          <Separator/>
          <RadioButton GroupName="SelectTheme" IsChecked="True" ToolTip="Switch to Light Theme">
            <Border Background="#F0F0F0" Padding="2,4">
              <TextBlock Text="Light" FontSize="11" Foreground="#000"/>
            </Border>
          </RadioButton>
          <RadioButton GroupName="SelectTheme" ToolTip="Switch to Dark Theme">
            <Border Background="#111" Padding="3,4">
              <TextBlock Text="Dark" FontSize="11" Foreground="#EEE"/>
            </Border>
          </RadioButton>
        </ToolBar>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/e6dd7ad2fd524dd7f46d990f47bad02a" TabIndex="300">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Item selection"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run FontWeight="Bold">ToolBar should show item selection choices using ComboBoxes.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <ToolBar Width="360">
          <Button ToolTip="Debug">
            <Path Data="M0,0L10,5 0,10z" Fill="#FF30B030" Margin="0,3"/>
          </Button>
          <ComboBox ToolTip="Configuration" SelectedIndex="0" Width="120">
            <ComboBoxItem Content="Debug"/>
            <ComboBoxItem Content="Profile"/>
            <ComboBoxItem Content="Release"/>
          </ComboBox>
          <ComboBox ToolTip="Platform" SelectedIndex="2" Width="120">
            <ComboBoxItem Content="ARM"/>
            <ComboBoxItem Content="x86"/>
            <ComboBoxItem Content="x64"/>
          </ComboBox>
        </ToolBar>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/65706acbf57fbcb7fb4093e0e1f20d86" TabIndex="400">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Text input"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Within a ToolBar you can also place TextBox controls to allow text input.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <ToolBar Width="360">
          <Button ToolTip="Search">
            <Image Source="Images/search.png" Height="16"/>
          </Button>
          <TextBox Width="250" noesis:Text.Placeholder="Search"/>
        </ToolBar>
      </Grid>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/ToolTip.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="ToolTip"
    Tag="https://www.noesisengine.com/docs/Gui.Core._ToolTip.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="A ToolTip shows more information about a UI element. You might show information about what element does, or what the user should do. The ToolTip is shown when a user hovers over the UI element."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/d4608e690c1acdf03b1d4ed97165fee4" TabIndex="100">
      <HeaderedContentControl.Header>
        <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Simple ToolTip"/>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Hover over buttons to show action info." Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Content="Add" ToolTip="Adds a new entry to the list." Width="150"/>
          <Button Content="Remove" ToolTip="Removes the selected entry from the list." Margin="10,0" Width="150"/>
        </StackPanel>
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/2daca51422cd1b24a1d561f5ba66a1b8" TabIndex="100">
      <HeaderedContentControl.Header>
        <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Custom Style"/>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Resources>
          <ControlTemplate x:Key="ToolTipTemplate" TargetType="ToolTip">
            <Border BorderThickness="4" BorderBrush="#FFA48A00" CornerRadius="6" Background="#EE000000" Padding="20,10">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
          <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="Template" Value="{StaticResource ToolTipTemplate}"/>
          </Style>
        </StackPanel.Resources>
        <Button Padding="0">
          <Button.ToolTip>
            <ToolTip>
              <StackPanel>
                <TextBlock Text="Magnifier" FontSize="18" FontWeight="Bold" Foreground="Gold"/>
                <TextBlock Text="Makes part of the scene bigger so you can see things that could be hidden from normal view." TextWrapping="Wrap" MaxWidth="210" Margin="0,5" FontSize="14" Foreground="WhiteSmoke"/>
                <TextBlock Text="Concentration +2" FontSize="16" FontWeight="Bold" Foreground="#FF31BAFF"/>
              </StackPanel>
            </ToolTip>
          </Button.ToolTip>
          <Border Width="64" Height="64" BorderThickness="4" BorderBrush="#FF7E6A52" CornerRadius="1" Background="#FFC7A990" Padding="5">
            <Image Source="Images/search.png" Stretch="Uniform"/>
          </Border>
        </Button>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/TreeView.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="TreeView"
    Tag="https://www.noesisengine.com/docs/Gui.Core._TreeView.html">

    <StackPanel>
        <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The TreeView control is a hierarchical list pattern with expanding and collapsing nodes that can contain nested items."/>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/420e3061ca76e1690ae799fcc36452e5" TabIndex="100">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SampleSectionTitle}" Text="SelectedItem"/>
                    <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
                        <Run>Unlike other selector controls like ListBox, the</Run>
                        <Run FontWeight="Bold">SelectionItem</Run>
                        <Run>property of a TreeView is read-only, so it cannot be used to update the selection. Every time users selects another item in the TreeView the</Run>
                        <Run FontWeight="Bold">SelectedItemChanged</Run>
                        <Run>event will be raised.</Run>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl.Header>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="TreeView.SelectedItemChanged">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Duration="0:0:0.5" Storyboard.TargetName="Rect1" Storyboard.TargetProperty="Fill.Color" From="#00ADFF2F" To="#FFADFF2F"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <TreeView x:Name="Tree1" Grid.RowSpan="4" Grid.Column="0" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Height="200" Margin="0,0,20,0">
                    <TreeViewItem Header="Level 1">
                        <TreeViewItem Header="Level 1.1">
                            <TreeViewItem Header="Level 1.1.1"/>
                            <TreeViewItem Header="Level 1.1.2"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Level 1.2"/>
                        <TreeViewItem Header="Level 1.3"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Level 2">
                        <TreeViewItem Header="Level 2.1"/>
                        <TreeViewItem Header="Level 2.2"/>
                        <TreeViewItem Header="Level 2.3"/>
                        <TreeViewItem Header="Level 2.4"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Level 3">
                        <TreeViewItem Header="Level 3.1"/>
                        <TreeViewItem Header="Level 3.2">
                            <TreeViewItem Header="Level 3.2.1"/>
                            <TreeViewItem Header="Level 3.2.2">
                                <TreeViewItem Header="Level 3.2.2.1"/>
                                <TreeViewItem Header="Level 3.2.2.2"/>
                            </TreeViewItem>
                            <TreeViewItem Header="Level 3.2.3"/>
                            <TreeViewItem Header="Level 3.2.4"/>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="Level 4">
                        <TreeViewItem Header="Level 4.1"/>
                        <TreeViewItem Header="Level 4.2"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Level 5"/>
                    <TreeViewItem Header="Level 6">
                        <TreeViewItem Header="Level 6.1"/>
                        <TreeViewItem Header="Level 6.2"/>
                        <TreeViewItem Header="Level 6.3"/>
                        <TreeViewItem Header="Level 6.4"/>
                        <TreeViewItem Header="Level 6.5"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Level 7">
                        <TreeViewItem Header="Level 7.1"/>
                        <TreeViewItem Header="Level 7.2">
                            <TreeViewItem Header="Level 7.2.1"/>
                            <TreeViewItem Header="Level 7.2.2"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Level 7.3"/>
                    </TreeViewItem>
                </TreeView>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="SelectedItem" FontSize="13" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Header, ElementName=Tree1}" Margin="5,0,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="SelectedItemChanged" FontSize="13" FontWeight="Bold" Margin="0,10,0,0"/>
                <Grid Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" Margin="5,5,0,0">
                    <Rectangle Fill="DodgerBlue" Width="50"/>
                    <Rectangle Fill="#FFADFF2F" Width="50" x:Name="Rect1"/>
                </Grid>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/7f9eb32579ce0c4d801bfd550c5fc2a5" TabIndex="200">
            <HeaderedContentControl.Header>
                <TextBlock Style="{StaticResource SampleSectionTitle}" Text="ItemsSource and item visualization"/>
            </HeaderedContentControl.Header>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <TransformGroup x:Key="FileSystem">
                        <TransformGroup Storyboard.TargetName="Computer" Selector.IsSelected="True">
                            <TransformGroup Storyboard.TargetName="Games">
                                <TranslateTransform Storyboard.TargetName="Bouncing Ball"/>
                                <TranslateTransform Storyboard.TargetName="Duck Hunt"/>
                                <TranslateTransform Storyboard.TargetName="Tic Tac Toe"/>
                            </TransformGroup>
                            <TransformGroup Storyboard.TargetName="ProgramFiles">
                                <TransformGroup Storyboard.TargetName="7-Zip"/>
                                <TransformGroup Storyboard.TargetName="Adobe"/>
                                <TransformGroup Storyboard.TargetName="Microsoft"/>
                                <TransformGroup Storyboard.TargetName="NoesisGUI"/>
                                <TransformGroup Storyboard.TargetName="Unity"/>
                            </TransformGroup>
                            <RotateTransform Storyboard.TargetName="Recycle Bin"/>
                            <TransformGroup Storyboard.TargetName="Users">
                                <TransformGroup Storyboard.TargetName="Administrator"/>
                                <TransformGroup Storyboard.TargetName="Jane Rae"/>
                                <TransformGroup Storyboard.TargetName="John Doe"/>
                            </TransformGroup>
                            <TransformGroup Storyboard.TargetName="Windows">
                                <TransformGroup Storyboard.TargetName="Boot"/>
                                <TransformGroup Storyboard.TargetName="Cursors"/>
                                <TransformGroup Storyboard.TargetName="Fonts">
                                    <TranslateTransform Storyboard.TargetName="Arial.ttf"/>
                                    <TranslateTransform Storyboard.TargetName="Courier New.ttf"/>
                                    <TranslateTransform Storyboard.TargetName="Tahoma.ttf"/>
                                    <TranslateTransform Storyboard.TargetName="Times New Roman.ttf"/>
                                    <TranslateTransform Storyboard.TargetName="Verdana.ttf"/>
                                </TransformGroup>
                                <TransformGroup Storyboard.TargetName="Media"/>
                                <TransformGroup Storyboard.TargetName="Resources"/>
                                <TransformGroup Storyboard.TargetName="Themes"/>
                                <TransformGroup Storyboard.TargetName="System32"/>
                            </TransformGroup>
                        </TransformGroup>
                    </TransformGroup>
                    <HierarchicalDataTemplate DataType="{x:Type TransformGroup}" ItemsSource="{Binding Children}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="icon" Width="24" Height="24" Source="Images/folder-closed.png"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Path=(Storyboard.TargetName)}"/>
                        </Grid>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="Source" Value="Images/folder-open.png" TargetName="icon"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type TranslateTransform}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="icon" Width="24" Height="24" Source="Images/file.png"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Path=(Storyboard.TargetName)}"/>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type RotateTransform}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="icon" Width="24" Height="24" Source="Images/recycling-bin.png"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Path=(Storyboard.TargetName)}"/>
                        </Grid>
                    </DataTemplate>
                </StackPanel.Resources>
                <TreeView ItemsSource="{Binding Children, Source={StaticResource FileSystem}}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1" Width="300" Height="250">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding (Selector.IsSelected)}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/UniformGrid.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="Grid"
    Tag="https://www.noesisengine.com/docs/Gui.Core._Grid.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The Grid is used to arrange controls and content in rows and columns."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/c9a33579595fe175d514a37bb1057e85" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Content layout"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>Content is positioned in the Grid using</Run>
            <Run FontWeight="Bold">Grid.Row</Run><Run>,</Run>
            <Run FontWeight="Bold">Grid.RowSpan</Run><Run>,</Run>
            <Run FontWeight="Bold">Grid.Column</Run>
            <Run>and</Run>
            <Run FontWeight="Bold">Grid.ColumnSpan</Run>
            <Run>attached properties.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="First column" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <Slider x:Name="firstCol" Minimum="0" Maximum="2" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" Width="180" Margin="10,0" TickPlacement="BottomRight"/>
          <TextBlock Text="{Binding FirstColumn, ElementName=uniformGrid}" Width="40" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Columns" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <Slider x:Name="cols" Minimum="3" Maximum="6" Value="4" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" Width="180" Margin="10,0" TickPlacement="BottomRight"/>
          <TextBlock Text="{Binding Columns, ElementName=uniformGrid}" Width="40" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
          <TextBlock Text="Rows" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <Slider x:Name="rows" Minimum="3" Maximum="6" Value="4" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" Width="180" Margin="10,0" TickPlacement="BottomRight"/>
          <TextBlock Text="{Binding Rows, ElementName=uniformGrid}" Width="40" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Background.Popup}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
          <UniformGrid x:Name="uniformGrid" Width="350" Height="350" ClipToBounds="True"
                    FirstColumn="{Binding Value, ElementName=firstCol}"
                    Columns="{Binding Value, ElementName=cols}"
                    Rows="{Binding Value, ElementName=rows}">
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
            <Rectangle Fill="LightSeaGreen" Margin="2"/>
          </UniformGrid>
        </Border>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "Samples/WrapPanel.xaml", R"AEROXAML(<HeaderedContentControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1280" d:DesignHeight="720"
    Style="{StaticResource SampleControlStyle}"
    Header="WrapPanel"
    Tag="https://www.noesisengine.com/docs/Gui.Core._WrapPanel.html">

  <StackPanel>
    <TextBlock Style="{StaticResource SampleSectionDesc}" Text="The WrapPanel positions child elements sequentially from left to right, breaking content to the next line at the edge of the containing box."/>
    <HeaderedContentControl Style="{StaticResource SampleSectionStyle}" Tag="https://www.noesisengine.com/xamltoy/a0a1d237d0411964324a4fce14204dd6" TabIndex="100">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource SampleSectionTitle}" Text="Content layout"/>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run FontWeight="Bold">Orientation</Run>
            <Run>property can be set to Vertical to position child elements from top to bottom.</Run>
          </TextBlock>
          <TextBlock Style="{StaticResource SampleSectionDesc}" Margin="0,5,0,0">
            <Run>By default each item gets the minimum space required to render, but a fixed width and height can be specified for all items with</Run>
            <Run FontWeight="Bold">ItemWidth</Run>
            <Run>and</Run>
            <Run FontWeight="Bold">ItemHeight</Run>
            <Run>properties.</Run>
          </TextBlock>
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Orientantion" Width="100" VerticalAlignment="Center"/>
          <ComboBox x:Name="orientation" Width="200" Margin="15,0,0,0" SelectedIndex="0">
            <ComboBoxItem Content="Horizontal"/>
            <ComboBoxItem Content="Vertical"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="ItemWidth" Width="100" VerticalAlignment="Center"/>
          <ComboBox x:Name="itemWidth" Width="200" Margin="15,0,0,0" SelectedIndex="0">
            <ComboBoxItem Content="Auto"/>
            <ComboBoxItem Content="175"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
          <TextBlock Text="ItemHeight" Width="100" VerticalAlignment="Center"/>
          <ComboBox x:Name="itemHeight" Width="200" Margin="15,0,0,0" SelectedIndex="0">
            <ComboBoxItem Content="Auto"/>
            <ComboBoxItem Content="100"/>
          </ComboBox>
        </StackPanel>
        <Border Background="{DynamicResource Brush.Background.Popup}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
          <WrapPanel Width="350" Height="200"
                     Orientation="{Binding SelectedItem.Content, ElementName=orientation}"
                     ItemWidth="{Binding SelectedItem.Content, ElementName=itemWidth}"
                     ItemHeight="{Binding SelectedItem.Content, ElementName=itemHeight}">
            <Border Background="Turquoise" MinWidth="100" MinHeight="60" Margin="2">
              <TextBlock Text="1" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="LightSeaGreen" MinWidth="100" MinHeight="60" Margin="2">
              <TextBlock Text="2" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="Teal" MinWidth="100" MinHeight="60" Margin="2">
              <TextBlock Text="3" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="#7FFFEC" MinWidth="100" MinHeight="60" Margin="2">
              <TextBlock Text="4" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="Turquoise" MinWidth="100" MinHeight="60" Margin="2">
              <TextBlock Text="5" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="LightSeaGreen" MinWidth="100" MinHeight="60" Margin="2">
              <TextBlock Text="6" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </WrapPanel>
        </Border>
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</HeaderedContentControl>)AEROXAML"},
    {"ControlGallery", "ThemeTest.xaml", R"AEROXAML(<Window x:Class="Gallery.ThemeTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
