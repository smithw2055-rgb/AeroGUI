{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AERO_BUILD_TESTS": "OFF",
        "AERO_BUILD_SAMPLES": "OFF",
        "AERO_ENABLE_EXCEPTIONS": "OFF",
        "AERO_ENABLE_RTTI": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "C++17 Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "C++17 Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-shared",
      "displayName": "C++17 Release Shared",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AERO_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "C++17 Linux Debug (WSL)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AERO_ENABLE_D3D11_BACKEND": "OFF",
        "AERO_ENABLE_WGL_SURFACE": "OFF",
        "AERO_ENABLE_GLX_SURFACE": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "C++17 Linux Release (WSL)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AERO_ENABLE_D3D11_BACKEND": "OFF",
        "AERO_ENABLE_WGL_SURFACE": "OFF",
        "AERO_ENABLE_GLX_SURFACE": "OFF"
      }
    },
    {
      "name": "linux-gui",
      "displayName": "C++17 Linux GUI Debug (WSL + GLX samples)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AERO_BUILD_SAMPLES": "ON",
        "AERO_ENABLE_GLX_SURFACE": "ON",
        "AERO_ENABLE_D3D11_BACKEND": "OFF",
        "AERO_ENABLE_WGL_SURFACE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-shared",
      "configurePreset": "release-shared"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-gui",
      "configurePreset": "linux-gui"
    }
  ]
}
