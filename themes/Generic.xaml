          <ControlTemplate.VisualStateGroups>
            <VisualStateGroup Name="SelectionStates">
              <VisualState Name="Selected">
                <Setter TargetName="HeaderChrome"
                        Property="Background"
                        Value="#332AA6E2"/>
              </VisualState>
              <VisualState Name="Unselected"/>
            </VisualStateGroup>
          </ControlTemplate.VisualStateGroups>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
