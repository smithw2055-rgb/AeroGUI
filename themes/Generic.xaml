<ResourceDictionary
    xmlns="urn:aero"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ControlForeground}"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Foreground" Value="{StaticResource ControlForeground}"/>
    <Setter Property="Template">
      <Setter.Value>
  <ControlTemplate TargetType="Button">
    <ControlTemplate.VisualTree>
      <Grid>
        <Border x:Name="Chrome"
                Background="{StaticResource ControlBackground}"
                BorderBrush="{StaticResource ControlBorder}"
                BorderThickness="1"
                Padding="8">
          <ContentPresenter x:Name="ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="FocusCue"
                BorderBrush="#00000000"
                BorderThickness="1"/>
      </Grid>
    </ControlTemplate.VisualTree>
    <ControlTemplate.VisualStateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualStateGroup.Transitions>
          <VisualTransition GeneratedDuration="0:0:0.09">
            <VisualTransition.GeneratedEasingFunction>
              <QuadraticEase EasingMode="EaseOut"/>
            </VisualTransition.GeneratedEasingFunction>
          </VisualTransition>
        </VisualStateGroup.Transitions>
        <VisualState Name="Normal"/>
        <VisualState Name="PointerOver">
          <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF1098DF"/>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Chrome"
                             Storyboard.TargetProperty="Opacity"
                             From="0.72"
                             To="1"
                             Duration="0:0:0.12"/>
          </Storyboard>
        </VisualState>
        <VisualState Name="Pressed">
          <Setter TargetName="Chrome" Property="Background" Value="#FFB9DDF5"/>
        </VisualState>
        <VisualState Name="Disabled">
          <Setter TargetName="Chrome" Property="Background" Value="#FF6B7379"/>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup Name="FocusStates">
        <VisualState Name="Focused">
          <Setter TargetName="FocusCue" Property="BorderBrush" Value="#FF1098DF"/>
        </VisualState>
        <VisualState Name="Unfocused">
          <Setter TargetName="FocusCue" Property="BorderBrush" Value="#00000000"/>
        </VisualState>
      </VisualStateGroup>
    </ControlTemplate.VisualStateGroups>
  </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentFill}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
