      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <ControlTemplate.VisualTree>
            <StackPanel>
              <Grid ColumnDefinitionsText="18,*,80,18">
                <Border x:Name="HeaderChrome"
                        Grid.ColumnSpan="4"
                        Background="#00000000"
                        BorderBrush="#00000000"
                        BorderThickness="1"/>
                <TextBlock x:Name="CheckGlyph"
                           Grid.Column="0"
