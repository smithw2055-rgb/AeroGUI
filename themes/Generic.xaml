                                    IsTabStop="False">
                        <RepeatButton.Template>
                          <ControlTemplate TargetType="RepeatButton">
                            <ControlTemplate.VisualTree>
                              <Border Background="Transparent"/>
                            </ControlTemplate.VisualTree>
                          </ControlTemplate>
                        </RepeatButton.Template>
                      </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand"
                                    Focusable="False"
                                    IsTabStop="False">
                        <RepeatButton.Template>
                          <ControlTemplate TargetType="RepeatButton">
                            <ControlTemplate.VisualTree>
                              <Border Background="Transparent"/>
                            </ControlTemplate.VisualTree>
                          </ControlTemplate>
                        </RepeatButton.Template>
                      </RepeatButton>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb x:Name="Thumb"
                             Background="{StaticResource ControlBorder}"/>
                    </Track.Thumb>
                  </Track>
                </Border>
              </ControlTemplate.VisualTree>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

