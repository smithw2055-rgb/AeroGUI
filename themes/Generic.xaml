<ResourceDictionary
    xmlns="urn:aero"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate TargetType="Button">
    <ControlTemplate.VisualTree>
      <Grid>
        <Border x:Name="Chrome"
                Background="{StaticResource ControlBackground}"
                BorderBrush="{StaticResource ControlBorder}"
                BorderThickness="1"
                Padding="8"/>
        <ContentPresenter x:Name="ContentPresenter"/>
        <Border x:Name="FocusCue"
                BorderBrush="{StaticResource Transparent}"
                BorderThickness="1"/>
      </Grid>
    </ControlTemplate.VisualTree>
    <ControlTemplate.VisualStateGroups>
      <VisualStateGroup Name="CommonStates">
        <VisualState Name="Normal">
          <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlBackground}"/>
        </VisualState>
        <VisualState Name="PointerOver">
          <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBackground}"/>
        </VisualState>
        <VisualState Name="Pressed">
          <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressedBackground}"/>
        </VisualState>
        <VisualState Name="Disabled">
          <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBackground}"/>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup Name="FocusStates">
        <VisualState Name="Focused">
          <Setter TargetName="FocusCue" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
        </VisualState>
        <VisualState Name="Unfocused">
          <Setter TargetName="FocusCue" Property="BorderBrush" Value="{StaticResource Transparent}"/>
        </VisualState>
      </VisualStateGroup>
    </ControlTemplate.VisualStateGroups>
  </ControlTemplate>

