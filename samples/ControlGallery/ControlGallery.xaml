<Border xmlns="urn:aero"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gallery="urn:aero-control-gallery"
        x:Name="GalleryRoot"
        Width="900"
        Height="640"
        Background="#FFF4F6FA">
  <StackPanel Orientation="Vertical">
    <TextBlock x:Name="Title"
               Text="AeroGUI Control Gallery"
               Foreground="#FF172033"/>
    <TextBox x:Name="Input"
             Width="320"
             Height="32"
             Text="Runtime vertical slice"/>
    <TextBlock x:Name="BindingMirror"
               Text="Binding pending"
               Foreground="#FF344054"/>
    <Button x:Name="PrimaryButton"
            Width="180"
            Height="36">
      <TextBlock Text="Primary action"/>
    </Button>
    <CheckBox x:Name="FeatureCheck"
              Width="180"
              Height="32">
      <TextBlock Text="Enable feature"/>
    </CheckBox>
    <RadioButton x:Name="LightChoice"
                 Width="180"
                 Height="32"
                 GroupName="Theme">
      <TextBlock Text="Light theme"/>
    </RadioButton>
    <RadioButton x:Name="DarkChoice"
                 Width="180"
                 Height="32"
                 GroupName="Theme">
      <TextBlock Text="Dark theme"/>
    </RadioButton>
    <gallery:StatusBadge x:Name="ModuleBadge"
                         Width="260"
                         Height="36"
                         Accent="#FF1F9D68">
      <TextBlock Text="Custom module loaded"
                 Foreground="#FFFFFFFF"/>
    </gallery:StatusBadge>
    <ScrollViewer x:Name="Scroller"
                  Width="360"
                  Height="96"
                  CanVerticallyScroll="True">
      <StackPanel>
        <TextBlock Text="Scrollable row 1"/>
        <TextBlock Text="Scrollable row 2"/>
        <TextBlock Text="Scrollable row 3"/>
        <TextBlock Text="Scrollable row 4"/>
      </StackPanel>
    </ScrollViewer>
    <ListBox x:Name="BigList"
             Width="360"
             Height="120"/>
    <VirtualizingStackPanel x:Name="BigListPanel"
                            Width="360"
                            Height="120"
                            EstimatedItemExtent="24"
                            OverscanCount="2"/>
  </StackPanel>
</Border>
