<Window x:Class="Localization.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Localization"
    Foreground="#FFBEE8FF"
    Title="AeroGUI - Localization">
  <Window.Resources>
    <LinearGradientBrush x:Key="AeroLogoBg" EndPoint="0.5,1" StartPoint="0.5,0">
      <GradientStop Offset="0" Color="#FF184C79"/>
      <GradientStop Offset="0.05" Color="#FF1B5688"/>
      <GradientStop Offset="1" Color="#FF123859"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IndentBorder" EndPoint="0.5,1" StartPoint="0.5,0">
      <GradientStop Color="#FF17436A" Offset="0"/>
      <GradientStop Color="#FF164269" Offset="1"/>
    </LinearGradientBrush>
  </Window.Resources>
  <Grid x:Name="LayoutRoot" Background="{StaticResource AeroLogoBg}">
    <Grid.RowDefinitions><RowDefinition Height="90*"/><RowDefinition Height="800*"/><RowDefinition Height="90*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="50*"/><ColumnDefinition Width="900*"/><ColumnDefinition Width="50*"/></Grid.ColumnDefinitions>
    <Viewbox Grid.Column="1" Grid.Row="1">
      <Grid x:Name="Dialog" Width="420" Height="420">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderThickness="1" BorderBrush="#FF12435F" CornerRadius="4">
          <Border.Background><RadialGradientBrush GradientOrigin="0.5,0.1" Center="0.5,0.1" RadiusX="0.9" RadiusY="0.9"><GradientStop Color="#FF2C76B4" Offset="0"/><GradientStop Color="#FF154064" Offset="0.65"/><GradientStop Color="#FF123757" Offset="1"/></RadialGradientBrush></Border.Background>
          <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="AeroGUI" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource IndentBorder}" Background="#FF154565" Margin="0,0,0,16" Padding="6">
              <TextBlock x:Name="LanguageTitle" Text="{Binding SelectedLanguage.TitleLabel}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
            <Grid Grid.Row="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SelectedLanguage.SelectLabel}" VerticalAlignment="Center" Margin="0,5"/>
              <ComboBox x:Name="LanguageSelector" Grid.Column="1" Margin="8,3" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Text="{Binding SelectedLanguage.SoundLabel}" VerticalAlignment="Center" Margin="0,5"/>
              <Slider x:Name="SoundSlider" Grid.Row="1" Grid.Column="1" Margin="8,5" Minimum="0" Maximum="100" Value="{Binding SoundLevel, Mode=TwoWay}"/>
              <TextBlock Grid.Row="2" Text="{Binding SelectedLanguage.MusicLabel}" VerticalAlignment="Center" Margin="0,5"/>
              <Slider x:Name="MusicSlider" Grid.Row="2" Grid.Column="1" Margin="8,5" Minimum="0" Maximum="100" Value="{Binding MusicLevel, Mode=TwoWay}"/>
            </Grid>
            <TextBlock x:Name="LanguageDescription" Grid.Row="3" Text="{Binding SelectedLanguage.Description}" TextWrapping="Wrap" FontSize="13" Margin="4,22,4,0"/>
          </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="Select a language to update the sample at runtime" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#FF72BCE6"/>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
