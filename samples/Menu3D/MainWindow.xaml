<Window x:Class="Menu3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Menu3D"
        Title="AeroGUI-R - Menu3D">
  <Window.Resources>
    <Storyboard x:Key="Parallax">
      <DoubleAnimation Storyboard.TargetName="SkyAndSun" Storyboard.TargetProperty="RenderTransform.X" From="0" To="-160" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="BackClouds" Storyboard.TargetProperty="RenderTransform.X" From="0" To="120" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="Mountains" Storyboard.TargetProperty="RenderTransform.X" From="0" To="-80" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="FrontClouds" Storyboard.TargetProperty="RenderTransform.X" From="0" To="180" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="FrontTrees" Storyboard.TargetProperty="RenderTransform.X" From="0" To="-100" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever" />
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource Parallax}" />
    </EventTrigger>
  </Window.Triggers>
  <Grid ClipToBounds="True" Background="#FF061723">
    <Image x:Name="SkyAndSun" Source="Images/SkyAndSun.png" Stretch="UniformToFill" Opacity="0.95">
      <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
    </Image>
    <Image x:Name="BackClouds" Source="Images/BackClouds.png" Stretch="UniformToFill" Opacity="0.45" VerticalAlignment="Top" Height="390">
      <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
    </Image>
    <Image x:Name="Mountains" Source="Images/LakeAndMountains.png" Stretch="UniformToFill" VerticalAlignment="Bottom" Height="500">
      <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
    </Image>
    <Image x:Name="FrontClouds" Source="Images/FrontClouds.png" Stretch="UniformToFill" Opacity="0.7" VerticalAlignment="Top" Height="440">
      <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
    </Image>
    <Image x:Name="FrontTrees" Source="Images/FrontTrees.png" Stretch="UniformToFill" VerticalAlignment="Bottom" Height="260">
      <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
    </Image>
    <Border Background="#59000000" Padding="72,48">
      <Grid Width="760" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid x:Name="MainMenu">
          <StackPanel>
            <TextBlock Text="AERO GUI" FontSize="68" FontWeight="Bold" Foreground="#FF6FD8FF" />
            <TextBlock Text="MENU 3D" FontSize="34" Foreground="#EFFFFFFF" Margin="4,-10,0,48" />
            <TextBlock Text="MAIN MENU" FontSize="22" Foreground="#DFFFFFFF" Margin="0,0,0,14" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="START GAME" Command="{Binding Start}" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="SETTINGS" Command="{Binding Settings}" Margin="0,10,0,0" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="EXIT" Command="{Binding Exit}" Margin="0,10,0,0" />
            <TextBlock Text="ENTER  ACCEPT       ESC  EXIT" FontSize="18" Foreground="#CCFFFFFF" Margin="4,36,0,0" />
          </StackPanel>
        </Grid>
        <Grid x:Name="StartMenu" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="SELECT DIFFICULTY" FontSize="46" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,24" />
            <TextBlock x:Name="StartStatus" Text="CHOOSE YOUR ADVENTURE" FontSize="20" Foreground="#FFBDEBFF" Margin="0,0,0,16" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="CASUAL" Command="{Binding StartCasual}" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="NORMAL" Command="{Binding StartNormal}" Margin="0,10,0,0" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="EXPERT" Command="{Binding StartExpert}" Margin="0,10,0,0" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="BACK" Command="{Binding Back}" Margin="0,32,0,0" />
          </StackPanel>
        </Grid>
        <Grid x:Name="SettingsMenu" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="SETTINGS" FontSize="46" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,24" />
            <TextBlock Text="TEXTURE DETAIL     HIGH" FontSize="22" Foreground="#EFFFFFFF" Margin="0,10" />
            <TextBlock Text="ANTI-ALIASING      ON" FontSize="22" Foreground="#EFFFFFFF" Margin="0,10" />
            <TextBlock Text="SOUND VOLUME       100%" FontSize="22" Foreground="#EFFFFFFF" Margin="0,10" />
            <TextBlock Text="RESOLUTION         1280 × 720" FontSize="22" Foreground="#EFFFFFFF" Margin="0,10" />
            <Button FontSize="26" Foreground="#FFFFFFFF" Content="BACK" Command="{Binding Back}" Margin="0,32,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
