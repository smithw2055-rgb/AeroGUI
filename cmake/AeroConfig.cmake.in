@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(@AERO_PACKAGE_WITH_EXPAT@)
    find_dependency(EXPAT)
endif()
if(@AERO_PACKAGE_WITH_GLX@)
    find_dependency(X11)
    find_dependency(OpenGL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AeroTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/AeroAddXaml.cmake")

set(Aero_VERSION "@PROJECT_VERSION@")
set(Aero_CPP_ABI_VERSION @AERO_CPP_ABI_VERSION@)
set(Aero_MODULE_ABI_VERSION @AERO_MODULE_ABI_VERSION@)
set(Aero_XAML_FACET_ABI_VERSION @AERO_XAML_FACET_ABI_VERSION@)
set(Aero_XAML_SCHEMA_ABI_VERSION @AERO_XAML_SCHEMA_ABI_VERSION@)
set(Aero_XAML_DOCUMENT_CACHE_ABI_VERSION @AERO_XAML_DOCUMENT_CACHE_ABI_VERSION@)
set(Aero_XAML_SCHEMA_MANIFEST_FORMAT_VERSION @AERO_XAML_SCHEMA_MANIFEST_FORMAT_VERSION@)
set(Aero_XAML_COMPILED_CACHE_FORMAT_VERSION @AERO_XAML_COMPILED_CACHE_FORMAT_VERSION@)
set(Aero_XAML_COMPILED_DOCUMENT_ENCODING_VERSION @AERO_XAML_COMPILED_DOCUMENT_ENCODING_VERSION@)
set(Aero_RUNTIME_ABI_VERSION @AERO_RUNTIME_ABI_VERSION@)
set(Aero_SCHEMA_MANIFEST
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/Aero/schema/Aero.aeroschema")
check_required_components(Aero)
