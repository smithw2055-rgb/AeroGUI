                .Changed(
                    &OnScrollViewerVisibilityChanged))
        .Property(
            ScrollViewer::
                VerticalScrollBarVisibilityProperty,
            PropertyOptions(
                ScrollBarVisibility::Visible)
                .AffectsMeasure()
