        .Content<GradientStop>(
            "Items", ContentKind::Collection,
            &AddGradientStopCollectionItem,
            &ClearGradientStopCollectionItems)
        .Factory();
    status = gradientStopCollection.Result();
    if (!status) return status.GetStatus();

    auto monochromeBrush = Describe<MonochromeBrush>(context);
    monochromeBrush
        .Property<Color, &MonochromeBrush::ColorValue,
            &MonochromeBrush::SetColor>("Color")
        .Factory();
    status = monochromeBrush.Result();
    if (!status) return status.GetStatus();

    auto conicGradientBrush = Describe<ConicGradientBrush>(context);
    conicGradientBrush
        .Content<GradientStop>(
            "GradientStops", ContentKind::Collection,
            [](Base::Object& owner, const Base::Ref<Base::Object>& value, void*) noexcept {
                return static_cast<ConicGradientBrush&>(owner).AddGradientStop(
                    Base::Ref<GradientStop>::FromBorrowed(
                        static_cast<GradientStop&>(*value)));
            },
            [](Base::Object& owner, void*) noexcept {
                static_cast<ConicGradientBrush&>(owner).ClearGradientStops(); return Base::Result<void>();
            })
        .Factory();
    status = conicGradientBrush.Result();
    if (!status) return status.GetStatus();

    auto wavesBrush = Describe<WavesBrush>(context);
    wavesBrush
        .Property<double, &WavesBrush::Time, &WavesBrush::SetTime>("Time")
        .Factory();
    status = wavesBrush.Result();
    if (!status) return status.GetStatus();

    auto gradientBrush = Describe<GradientBrush>(
        context, TypeFlags::Abstract);
    gradientBrush
        .Property(
            GradientBrush::MappingModeProperty,
            PropertyOptions(
                BrushMappingMode::RelativeToBoundingBox))
        .Content<GradientStop>(
            "GradientStops",
            ContentKind::Collection,
            &AddGradientStop,
            &ClearGradientStops);
    status = gradientBrush.Result();
    if (!status) return status.GetStatus();

    auto linearBrush =
        Describe<LinearGradientBrush>(context);
    linearBrush
        .Property(
            LinearGradientBrush::StartPointProperty,
            PropertyOptions(Point{0.0, 0.0}))
        .Property(
            LinearGradientBrush::EndPointProperty,
            PropertyOptions(Point{1.0, 1.0}))
        .Factory();
    status = linearBrush.Result();
    if (!status) return status.GetStatus();

    auto radialBrush =
        Describe<RadialGradientBrush>(context);
    radialBrush
        .Property(
            RadialGradientBrush::CenterProperty,
            PropertyOptions(Point{0.5, 0.5}))
        .Property(
            RadialGradientBrush::GradientOriginProperty,
            PropertyOptions(Point{0.5, 0.5}))
        .Property(
            RadialGradientBrush::RadiusXProperty,
            PropertyOptions(0.5)
                .Validate(&Validate::Positive<double>))
        .Property(
            RadialGradientBrush::RadiusYProperty,
            PropertyOptions(0.5)
                .Validate(&Validate::Positive<double>))
        .Factory();
    status = radialBrush.Result();
    if (!status) return status.GetStatus();

    auto imageSource = Describe<ImageSource>(
        context, TypeFlags::Abstract);
    imageSource.TextConverter(
        &ConvertImageSourceText);
    status = imageSource.Result();
    if (!status) return status.GetStatus();

    auto bitmapImage =
        Describe<BitmapImage>(context);
    bitmapImage
        .Property(
            BitmapImage::UriSourceProperty,
            PropertyOptions(
                Base::ResourceUri{}))
        .Factory();
    status = bitmapImage.Result();
    if (!status) return status.GetStatus();

    auto imageBrush =
        Describe<ImageBrush>(context);
    imageBrush
        .Property(
            ImageBrush::ImageSourceProperty,
            PropertyOptions(
                Base::Ref<ImageSource>{}))
        .Property(
            ImageBrush::StretchProperty,
            PropertyOptions(Stretch::Fill))
        .Property(
            ImageBrush::ViewboxProperty,
            PropertyOptions(
                Rect{0.0, 0.0, 1.0, 1.0}))
        .Property(
            ImageBrush::ViewportProperty,
            PropertyOptions(
                Rect{0.0, 0.0, 1.0, 1.0}))
        .Property(
            ImageBrush::TileModeProperty,
            PropertyOptions(TileMode::None))
        .Factory();
    status = imageBrush.Result();
    if (!status) return status.GetStatus();

    auto matrix = Describe<Transform2D>(context);
    matrix
        .Field<&Transform2D::m11>("M11")
        .Field<&Transform2D::m12>("M12")
        .Field<&Transform2D::m21>("M21")
        .Field<&Transform2D::m22>("M22")
        .Field<&Transform2D::dx>("OffsetX")
        .Field<&Transform2D::dy>("OffsetY")
        .ValueSemantics()
        .TextConverter<&ConvertMatrix>();
    status = matrix.Result();
    if (!status) return status.GetStatus();

    auto translate = Describe<TranslateTransform>(context);
    translate
        .Property(
            TranslateTransform::XProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            TranslateTransform::YProperty,
            PropertyOptions(0.0).AffectsRender())
        .Factory();
    status = translate.Result();
    if (!status) return status.GetStatus();

    auto scale = Describe<ScaleTransform>(context);
    scale
        .Property(
            ScaleTransform::ScaleXProperty,
            PropertyOptions(1.0).AffectsRender())
        .Property(
            ScaleTransform::ScaleYProperty,
            PropertyOptions(1.0).AffectsRender())
        .Property(
            ScaleTransform::CenterXProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            ScaleTransform::CenterYProperty,
            PropertyOptions(0.0).AffectsRender())
        .Factory();
    status = scale.Result();
    if (!status) return status.GetStatus();

    auto rotate = Describe<RotateTransform>(context);
    rotate
        .Property(
            RotateTransform::AngleProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            RotateTransform::CenterXProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            RotateTransform::CenterYProperty,
            PropertyOptions(0.0).AffectsRender())
        .Factory();
    status = rotate.Result();
    if (!status) return status.GetStatus();

    auto skew = Describe<SkewTransform>(context);
    skew
        .Property(
            SkewTransform::AngleXProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            SkewTransform::AngleYProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            SkewTransform::CenterXProperty,
            PropertyOptions(0.0).AffectsRender())
        .Property(
            SkewTransform::CenterYProperty,
            PropertyOptions(0.0).AffectsRender())
        .Factory();
    status = skew.Result();
    if (!status) return status.GetStatus();

    auto matrixTransform = Describe<MatrixTransform>(context);
    matrixTransform
        .Property(
            MatrixTransform::MatrixProperty,
            PropertyOptions(Transform2D{}).AffectsRender())
        .Factory();
    status = matrixTransform.Result();
    if (!status) return status.GetStatus();

    auto transformGroup = Describe<TransformGroup>(context);
    transformGroup
        .Content<Transform>(
            "Children",
            ContentKind::Collection,
            &AddTransformGroupChild,
            &ClearTransformGroupChildren)
        .Factory();
    status = transformGroup.Result();
    if (!status) return status.GetStatus();

    status = Describe<Effect>(
        context, TypeFlags::Abstract).Result();
    if (!status) return status.GetStatus();

    auto blurEffect = Describe<BlurEffect>(context);
    blurEffect
        .Property(
            BlurEffect::RadiusProperty,
            PropertyOptions(5.0)
                .AffectsRender()
                .Validate(&Validate::NonNegative<double>))
        .Factory();
    status = blurEffect.Result();
    if (!status) return status.GetStatus();

    auto dropShadowEffect =
        Describe<DropShadowEffect>(context);
    dropShadowEffect
        .Property(
            DropShadowEffect::BlurRadiusProperty,
            PropertyOptions(5.0)
                .AffectsRender()
                .Validate(&Validate::NonNegative<double>))
        .Property(
            DropShadowEffect::DirectionProperty,
            PropertyOptions(315.0)
                .AffectsRender())
        .Property(
            DropShadowEffect::ShadowDepthProperty,
            PropertyOptions(5.0)
                .AffectsRender()
                .Validate(&Validate::NonNegative<double>))
        .Property(
            DropShadowEffect::OpacityProperty,
            PropertyOptions(1.0)
                .AffectsRender()
                .Validate(&ValidateUnitDouble))
        .Property(
            DropShadowEffect::ColorProperty,
            PropertyOptions(
                Base::Color{
                    0.0F, 0.0F, 0.0F, 1.0F})
                .AffectsRender())
        .Factory();
    status = dropShadowEffect.Result();
    if (!status) return status.GetStatus();

    auto pixelateEffect = Describe<PixelateEffect>(context);
    pixelateEffect
        .Property(
            PixelateEffect::SizeProperty,
            PropertyOptions(1.0)
                .AffectsRender()
                .Validate(&Validate::Positive<double>))
        .Factory();
    status = pixelateEffect.Result();
    if (!status) return status.GetStatus();

    auto horizontal = Describe<HorizontalAlignment>(context);
    horizontal
        .Value("Stretch", HorizontalAlignment::Stretch)
        .Value("Left", HorizontalAlignment::Left)
        .Value("Center", HorizontalAlignment::Center)
        .Value("Right", HorizontalAlignment::Right);
    status = horizontal.Result();
    if (!status) return status.GetStatus();

    auto vertical = Describe<VerticalAlignment>(context);
    vertical
        .Value("Stretch", VerticalAlignment::Stretch)
        .Value("Top", VerticalAlignment::Top)
        .Value("Center", VerticalAlignment::Center)
        .Value("Bottom", VerticalAlignment::Bottom);
    status = vertical.Result();
    if (!status) return status.GetStatus();

    auto visualBrush = Describe<VisualBrush>(context);
    visualBrush
        .Property(
            VisualBrush::VisualProperty,
            PropertyOptions(Base::Ref<Base::Object>{}))
        .Property(
            VisualBrush::StretchProperty,
            PropertyOptions(Stretch::Fill))
        .Property(
            VisualBrush::ViewboxProperty,
            PropertyOptions(Rect{0.0, 0.0, 1.0, 1.0}))
        .Property(
            VisualBrush::AlignmentYProperty,
            PropertyOptions(VerticalAlignment::Center))
        .Factory();
    status = visualBrush.Result();
    if (!status) return status.GetStatus();

    auto visibility = Describe<Visibility>(context);
    visibility
        .Value("Visible", Visibility::Visible)
        .Value("Hidden", Visibility::Hidden)
        .Value("Collapsed", Visibility::Collapsed);
    status = visibility.Result();
    if (!status) return status.GetStatus();

    auto blendMode = Describe<BlendMode>(context);
    blendMode
        .Value("Normal", BlendMode::Normal)
        .Value("Multiply", BlendMode::Multiply)
        .Value("Screen", BlendMode::Screen)
        .Value("Additive", BlendMode::Additive);
    status = blendMode.Result();
    if (!status) return status.GetStatus();

    auto command = Describe<ICommand>(
        context, TypeFlags::Abstract);
    command.TextConverter(
        &ConvertRoutedCommandReference);
    status = command.Result();
    if (!status) return status.GetStatus();
    status = Describe<InputGesture>(
        context, TypeFlags::Abstract).Result();
    if (!status) return status.GetStatus();
    status = Describe<KeyGesture>(context).Result();
    if (!status) return status.GetStatus();
    status = Describe<RoutedCommand>(context).Result();
    if (!status) return status.GetStatus();
    return {};
}
