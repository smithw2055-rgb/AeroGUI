        .Value("Tile", TileMode::Tile)
        .Value("FlipX", TileMode::FlipX)
        .Value("FlipY", TileMode::FlipY)
        .Value("FlipXY", TileMode::FlipXY);
    status = tileMode.Result();
    if (!status) return status.GetStatus();

    auto brushMappingMode = Describe<BrushMappingMode>(context);
    brushMappingMode
        .Value(
            "RelativeToBoundingBox",
            BrushMappingMode::RelativeToBoundingBox)
        .Value("Absolute", BrushMappingMode::Absolute);
    status = brushMappingMode.Result();
    if (!status) return status.GetStatus();

    // Brush.RelativeTransform is a Transform-valued dependency property, so
    // the abstract value type must exist before Brush metadata is authored.
    status = Describe<Transform>(
        context, TypeFlags::Abstract).Result();
    if (!status) return status.GetStatus();

    auto brush = Describe<Brush>(
        context, TypeFlags::Abstract);
    brush
        .Property(
            Brush::OpacityProperty,
            PropertyOptions(1.0)
                .Validate(&ValidateUnitDouble))
        .Property(
            Brush::ShaderProperty,
            PropertyOptions(Base::Ref<Base::Object>{}))
        .Property(
            Brush::RelativeTransformProperty,
            PropertyOptions(Base::Ref<Transform>{}))
        .TextConverter(&ConvertBrushText);
    status = brush.Result();
    if (!status) return status.GetStatus();

    auto solidBrush =
        Describe<SolidColorBrush>(context);
    solidBrush
        .Property(
            SolidColorBrush::ColorProperty,
            PropertyOptions(Color{}))
        .Factory();
    status = solidBrush.Result();
    if (!status) return status.GetStatus();

    auto gradientStop =
        Describe<GradientStop>(context);
    gradientStop
        .Property(
            GradientStop::OffsetProperty,
            PropertyOptions(0.0)
